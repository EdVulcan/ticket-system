<view class="page">
  <view class="header"><text class="title">确认订单</text><text class="header-hint">核对商品、数量与订单信息后发起小红书担保支付</text></view>
  <view class="loading-state" xhs:if="{{loading}}"><view class="loading-card"><view class="loading-thumb"></view><view class="loading-lines"><view class="loading-line wide"></view><view class="loading-line"></view><view class="loading-line short"></view></view></view><text class="loading-copy">正在加载商品...</text></view>
  <view class="state error-state" xhs:elif="{{error && !product}}"><text class="state-title">暂时无法加载商品</text><text class="state-detail">{{error}}</text><button class="retry-button" bindtap="retry">重新加载</button></view>
  <view class="content" xhs:elif="{{product}}">
    <view class="ticket">
      <image class="ticket-image" xhs:if="{{product.image_url}}" src="{{product.image_url}}" mode="aspectFill" />
      <view class="ticket-image fallback" xhs:else><image class="ticket-icon" src="../../assets/ticket.svg" mode="aspectFit" /></view>
      <view class="ticket-info"><text class="ticket-name">{{product.name}}</text><text class="ticket-scenic">{{product.isPackage ? product.stayText : product.scenic_area_name}}</text><text class="price">¥{{product.priceText}}</text></view>
    </view>
    <view class="date-card" xhs:if="{{product.requiresUseDate && !createdOrderNo}}"><view class="date-top"><view><text class="label">{{product.useDateLabel}}</text><text class="hint">{{product.isPackage ? '离店日期将按套餐晚数自动计算' : '门票按所选日期预订'}}</text></view><text class="date-value {{useDate ? 'selected' : ''}}">{{useDate || '请选择'}}</text></view><view class="date-chips"><button xhs:for="{{dateChips}}" xhs:for-item="chip" xhs:key="iso" class="{{chip.className}} {{chip.isDisabled ? 'is-disabled' : ''}}" data-date="{{chip.iso}}" disabled="{{chip.isDisabled}}" bindtap="selectDate"><text>{{chip.label}}</text><text class="chip-date">{{chip.dateText}}</text></button><button class="more-date" bindtap="toggleCalendar"><text>{{calendarOpen ? '收起日历' : '更多日期'}}</text><text class="chip-date">选择日期</text></button></view><view class="calendar" xhs:if="{{calendarOpen}}"><view class="calendar-header"><button class="{{!canPreviousMonth ? 'is-disabled' : ''}}" disabled="{{!canPreviousMonth}}" bindtap="previousMonth">上月</button><text>{{calendarTitle}}</text><button class="{{!canNextMonth ? 'is-disabled' : ''}}" disabled="{{!canNextMonth}}" bindtap="nextMonth">下月</button></view><view class="weekdays"><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text><text>日</text></view><view class="calendar-grid"><view xhs:for="{{calendarCells}}" xhs:for-item="cell" xhs:key="key" class="{{cell.className}}"><button xhs:if="{{cell.isDate}}" class="calendar-day-button {{cell.isDisabled ? 'is-disabled' : ''}}" data-date="{{cell.iso}}" disabled="{{cell.isDisabled}}" bindtap="selectDate">{{cell.label}}</button></view></view></view></view>
    <view class="guest-card" xhs:if="{{product.isDeferredPackage}}">
      <text class="label">购买后预约入住</text>
      <text class="hint">支付后，每份套餐可在订单中分别选择入住日期并填写入住联系人。当前不会提前占用房量。</text>
    </view>
    <view class="guest-card" xhs:elif="{{product.isPackage}}">
      <text class="label">入住联系人</text>
      <text class="hint">用于酒店确认预订，不作为门票实名信息</text>
      <view class="field-row"><text>入住人</text><input disabled="{{submitting || createdOrderNo}}" class="field-input" maxlength="50" placeholder="请输入姓名" placeholder-class="field-placeholder" value="{{guestName}}" bindinput="onGuestNameInput" /></view>
      <view class="field-row"><text>联系电话</text><input disabled="{{submitting || createdOrderNo}}" class="field-input" type="number" maxlength="20" placeholder="用于接收住宿通知" placeholder-class="field-placeholder" value="{{contactPhone}}" bindinput="onContactPhoneInput" /></view>
    </view>
    <view class="quantity-row">
      <view><text class="label">{{product.quantityLabel}}</text><text class="hint">{{product.quantityHint}}</text></view>
      <view class="stepper"><button class="stepper-button {{quantity <= 1 || submitting || createdOrderNo ? 'is-disabled' : ''}}" bindtap="decrease" disabled="{{quantity <= 1 || submitting || createdOrderNo}}">−</button><text>{{quantity}}</text><button class="stepper-button {{quantity >= maxQuantity || submitting || createdOrderNo ? 'is-disabled' : ''}}" bindtap="increase" disabled="{{quantity >= maxQuantity || submitting || createdOrderNo}}">+</button></view>
    </view>
    <text class="limit" xhs:if="{{maxQuantity < 100}}">单次最多购买 {{maxQuantity}} {{product.isPackage ? '份' : '张'}}</text>
    <view class="notice"><text class="notice-title">购买须知</text><text>{{product.isDeferredPackage ? '支付成功后获得套餐预约权益，实际入住日期以预约时的可用房量为准；预约成功后才生成可用门票。' : (product.isPackage ? '每份套餐同时锁定门票和住宿房量，退改按整份套餐处理。' : '支付结果以小红书担保交易为准，支付成功后系统自动出票。退改按票种实际规则执行。')}}</text></view>
    <view class="summary"><view><text class="summary-label">单价</text><text>¥{{product.priceText}} × {{quantity}}</text></view><view class="summary-total"><text>合计</text><text class="total">¥{{totalText}}</text></view></view>
    <view class="notice" xhs:if="{{createdOrderNo}}"><text>订单已创建{{useDate ? ' · ' + useDate : ''}}。如需支付，请继续查看该订单。</text></view>
    <text class="inline-error" xhs:if="{{error}}">{{error}}</text>
    <view class="page-spacer"></view>
    <view class="checkout-bar"><view><text class="checkout-label">应付</text><text class="checkout-total">¥{{totalText}}</text></view><button class="pay-button {{submitting ? 'is-disabled' : ''}}" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{submitting ? (createdOrderNo ? '正在支付' : '正在创建订单') : (createdOrderNo ? '查看订单 · 继续支付' : '确认并支付')}}</button></view>
  </view>
</view>
