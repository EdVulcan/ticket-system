<view class="page">
  <view class="header"><text class="eyebrow">确认订单</text><text class="title">核对门票与数量</text></view>
  <view class="state" xhs:if="{{loading}}">正在加载票种...</view>
  <view class="state error" xhs:elif="{{error && !product}}">{{error}}</view>
  <view class="content" xhs:elif="{{product}}">
    <view class="ticket">
      <text class="ticket-name">{{product.name}}</text>
      <text class="ticket-scenic">{{product.scenic_area_name}}</text>
      <view class="price-row"><text>单价</text><text class="price">¥{{product.priceText}}</text></view>
    </view>
    <view class="quantity-row">
      <text class="label">购买数量</text>
      <view class="stepper"><button bindtap="decrease" disabled="{{quantity <= 1}}">−</button><text>{{quantity}}</text><button bindtap="increase" disabled="{{quantity >= maxQuantity}}">+</button></view>
    </view>
    <text class="limit" xhs:if="{{maxQuantity < 100}}">测试环境本票种最多购买 {{maxQuantity}} 张</text>
    <view class="summary"><text>应付金额</text><text class="total">¥{{totalText}}</text></view>
    <text class="inline-error" xhs:if="{{error}}">{{error}}</text>
    <button class="pay-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{submitting ? '正在创建订单' : '立即支付'}}</button>
  </view>
</view>
