<view class="page">
  <view class="result {{status}}">
    <view class="status-mark">{{statusMark}}</view>
    <text class="title">{{statusTitle}}</text>
    <text class="detail">{{statusDetail}}</text>
  </view>
  <view class="error" xhs:if="{{error}}"><text>{{error}}</text><button bindtap="retry">重新查询</button></view>
  <view class="tickets" xhs:if="{{ticketCodes.length}}">
    <text class="section-title">入园票码</text>
    <view class="ticket-code" xhs:for="{{ticketCodes}}" xhs:key="*this"><text>{{item}}</text></view>
  </view>
  <view class="order-no"><text>订单号</text><text>{{orderNo}}</text></view>
</view>
