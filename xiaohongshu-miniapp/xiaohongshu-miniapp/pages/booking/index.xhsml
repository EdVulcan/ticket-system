<view class="page">
  <view class="header"><text class="title">预约入住</text><text class="header-hint">选择日期后，系统将同时确认酒店房量和景区门票</text></view>
  <view class="state" xhs:if="{{loading}}">正在加载预约权益...</view>
  <view class="state error" xhs:elif="{{error && !entitlement}}">{{error}}</view>
  <view class="content" xhs:elif="{{entitlement}}">
    <view class="notice"><text class="notice-title">预约说明</text><text>本次预约不额外收费。预约成功后才会生成对应日期的有效门票；实际可订日期以房量和门票库存为准。</text></view>
    <view class="date-card"><view class="date-row"><view><text class="label">入住日期</text><text class="hint">可选 {{minDate}} 至 {{maxDate}}</text></view><text class="date-value {{checkInDate ? 'selected' : ''}}">{{checkInDate || '请选择'}}</text></view><view class="date-chips"><button xhs:for="{{dateChips}}" xhs:for-item="chip" xhs:key="iso" class="{{chip.className}}" data-date="{{chip.iso}}" disabled="{{chip.isDisabled}}" bindtap="selectDate"><text>{{chip.label}}</text><text class="chip-date">{{chip.dateText}}</text></button><button class="more-date" bindtap="toggleCalendar"><text>{{calendarOpen ? '收起日历' : '更多日期'}}</text><text class="chip-date">选择日期</text></button></view><view class="calendar" xhs:if="{{calendarOpen}}"><view class="calendar-header"><button disabled="{{!canPreviousMonth}}" bindtap="previousMonth">上月</button><text>{{calendarTitle}}</text><button disabled="{{!canNextMonth}}" bindtap="nextMonth">下月</button></view><view class="weekdays"><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text><text>日</text></view><view class="calendar-grid"><view xhs:for="{{calendarCells}}" xhs:for-item="cell" xhs:key="key" class="{{cell.className}}"><button xhs:if="{{cell.isDate}}" class="calendar-day-button" data-date="{{cell.iso}}" disabled="{{cell.isDisabled}}" bindtap="selectDate">{{cell.label}}</button></view></view></view></view>
    <view class="guest-card">
      <text class="label">入住联系人</text><text class="hint">仅用于本次套餐履约确认</text>
      <view class="field-row"><text>入住人</text><input class="field-input" maxlength="50" placeholder="请输入姓名" value="{{guestName}}" bindinput="onGuestNameInput" /></view>
      <view class="field-row"><text>联系电话</text><input class="field-input" type="number" maxlength="20" placeholder="用于接收住宿通知" value="{{contactPhone}}" bindinput="onContactPhoneInput" /></view>
    </view>
    <text class="inline-error" xhs:if="{{error}}">{{error}}</text>
    <button class="pay-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{submitting ? '正在确认' : '确认预约'}}</button>
  </view>
</view>
