<view class="page">
  <view class="header"><text class="title">预约入住</text><text class="header-hint">选择入住日期，填写本次入住联系人</text></view>
  <view class="ui-state" xhs:if="{{loading}}"><text class="ui-state-title">正在加载预约信息</text><text class="ui-state-detail">请稍候</text></view>
  <view class="ui-state" xhs:elif="{{error && !entitlement}}"><text class="ui-state-title">暂时无法预约</text><text class="ui-state-detail">{{error}}</text><button class="ui-state-action" bindtap="retry">重新加载</button><button class="back-order" bindtap="goOrder">返回订单</button></view>
  <view class="content" xhs:elif="{{entitlement}}">
    <view class="booking-summary"><text class="booking-name">{{entitlement.package_name || entitlement.product_name || '套餐预约'}}</text><text class="booking-hotel">{{entitlement.hotel_name}} · {{entitlement.room_type_name}}</text><text class="booking-stay">{{entitlement.rooms_per_package || 1}} 间 · {{entitlement.nights || 1}} 晚</text></view>
    <view class="notice"><text class="notice-title">预约说明</text><text>本次预约不额外收费。预约成功后才会生成对应日期的有效门票；实际可订日期以房量和门票库存为准。</text></view>
    <view class="date-card"><view class="date-row"><view><text class="label">入住日期</text><text class="hint">可选 {{minDate}} 至 {{maxDate}}</text></view><text class="date-value {{checkInDate ? 'selected' : ''}}">{{checkInDate || '请选择'}}</text></view><view class="date-chips"><button xhs:for="{{dateChips}}" xhs:for-item="chip" xhs:key="iso" class="{{chip.className}} {{chip.isDisabled ? 'is-disabled' : ''}}" data-date="{{chip.iso}}" disabled="{{chip.isDisabled}}" bindtap="selectDate"><text>{{chip.label}}</text><text class="chip-date">{{chip.dateText}}</text></button><button class="more-date" bindtap="toggleCalendar"><text>{{calendarOpen ? '收起日历' : '更多日期'}}</text><text class="chip-date">选择日期</text></button></view><view class="calendar" xhs:if="{{calendarOpen}}"><view class="calendar-header"><button class="{{!canPreviousMonth ? 'is-disabled' : ''}}" disabled="{{!canPreviousMonth}}" bindtap="previousMonth">上月</button><text>{{calendarTitle}}</text><button class="{{!canNextMonth ? 'is-disabled' : ''}}" disabled="{{!canNextMonth}}" bindtap="nextMonth">下月</button></view><view class="weekdays"><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text><text>日</text></view><view class="calendar-grid"><view xhs:for="{{calendarCells}}" xhs:for-item="cell" xhs:key="key" class="{{cell.className}}"><button xhs:if="{{cell.isDate}}" class="calendar-day-button {{cell.isDisabled ? 'is-disabled' : ''}}" data-date="{{cell.iso}}" disabled="{{cell.isDisabled}}" bindtap="selectDate">{{cell.label}}</button></view></view></view></view>
    <view class="selected-stay" xhs:if="{{checkInDate}}"><text>{{checkInDate}} 入住</text><text>{{checkOutDate}} 离店</text></view>
    <view class="guest-card">
      <text class="label">入住联系人</text><text class="hint">仅用于本次套餐履约确认</text>
      <view class="field-row"><text>入住人</text><input disabled="{{submitting}}" class="field-input" maxlength="50" placeholder="请输入姓名" value="{{guestName}}" bindinput="onGuestNameInput" /></view>
      <view class="field-row"><text>联系电话</text><input disabled="{{submitting}}" class="field-input" type="number" maxlength="20" placeholder="请输入联系电话" value="{{contactPhone}}" bindinput="onContactPhoneInput" /></view>
    </view>
    <text class="inline-error" xhs:if="{{error}}">{{error}}</text>
    <button class="pay-button {{submitting ? 'is-disabled' : ''}}" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{submitting ? '正在确认' : '确认预约'}}</button>
  </view>
</view>
