<view class="page">
  <view class="store-header">
    <view class="brand-row">
      <view class="brand-copy"><text class="store-name">{{storeName}}</text><text class="store-kicker">门票与酒店套餐</text></view>
      <view class="orders-link" bindtap="goOrders"><text class="orders-icon">单</text><text>我的订单</text></view>
    </view>
  </view>

  <view class="feature" xhs:if="{{featuredProduct && !hasActiveFilters}}" data-id="{{featuredProduct.id}}" bindtap="openProduct">
    <image class="feature-image" xhs:if="{{featuredProduct && featuredProduct.image_url}}" src="{{featuredProduct.image_url}}" mode="aspectFill" />
    <view class="feature-image fallback" xhs:else><text class="fallback-label">{{featuredProduct.kindLabel}}</text><text class="fallback-product">{{featuredProduct.name}}</text></view>
    <view class="feature-copy">
      <view class="feature-line"><text class="feature-kind">{{featuredProduct.kindLabel}}</text></view>
      <text class="feature-title">{{featuredProduct.name}}</text>
      <view class="feature-foot"><view class="feature-detail"><text class="feature-place">{{featuredProduct.product_kind === 'scenic_hotel_package' ? featuredProduct.packageSummary : (featuredProduct.scenic_area_name || '景区门票')}}</text><text class="feature-note">{{featuredProduct.product_kind === 'scenic_hotel_package' ? (featuredProduct.booking_mode === 'after_purchase' ? '购买后预约入住' : '下单时选择入住日期') : '支付成功后查看票码'}}</text></view><view class="feature-price"><text class="feature-currency">¥</text>{{featuredProduct.priceText}}<text class="feature-unit">起</text></view><text class="feature-arrow">›</text></view>
    </view>
  </view>

  <view class="search-wrap">
    <view class="search-box">
      <text class="search-icon">⌕</text>
      <input class="search-input" value="{{keyword}}" bindinput="onKeywordInput" placeholder="搜索门票、套餐或房型" placeholder-class="search-placeholder" />
      <text class="clear" xhs:if="{{keyword}}" bindtap="clearKeyword">清除</text>
    </view>
  </view>

  <view class="selection-bar" xhs:if="{{hasActiveFilters}}">
    <view class="selection-summary"><text class="selection-label">当前筛选</text><text>{{products.length}} 个结果</text></view>
    <text class="reset-link" bindtap="resetFilters">清除筛选</text>
  </view>

  <view class="filters" xhs:if="{{!loading && !error && allProducts.length}}">
    <view class="section-heading"><view class="section-title-wrap"><text>可购买</text><text class="result-count">{{resultCount}} 个产品</text></view></view>
    <view class="kind-row" xhs:if="{{kindOptions.length > 1}}">
      <view class="kind-chip {{activeKind === item.value ? 'active' : ''}}" xhs:for="{{kindOptions}}" xhs:key="value" data-kind="{{item.value}}" bindtap="selectKind">{{item.label}}</view>
    </view>
    <scroll-view class="scenic-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="scenic-row">
        <view class="scenic-chip {{activeScenic === item ? 'active' : ''}}" xhs:for="{{scenicOptions}}" xhs:key="*this" data-scenic="{{item}}" bindtap="selectScenic">{{item}}</view>
      </view>
    </scroll-view>
    <view class="sort-row">
      <text class="sort-label">排序</text>
      <view class="sort-options">
        <text class="sort-item {{sort === 'default' ? 'active' : ''}}" data-sort="default" bindtap="selectSort">综合</text>
        <text class="sort-item {{sort === 'priceAsc' ? 'active' : ''}}" data-sort="priceAsc" bindtap="selectSort">低价优先</text>
        <text class="sort-item {{sort === 'priceDesc' ? 'active' : ''}}" data-sort="priceDesc" bindtap="selectSort">高价优先</text>
      </view>
    </view>
  </view>

  <view class="content">
    <view class="loading" xhs:if="{{loading}}">
      <view class="skeleton-image"></view><view class="skeleton-line wide"></view><view class="skeleton-line"></view>
    </view>
    <view class="state" xhs:elif="{{error}}">
      <text class="state-title">暂时无法加载商品</text><text class="state-detail">{{error}}</text>
      <button class="retry-button" bindtap="retry">重新加载</button>
    </view>
    <view class="state" xhs:elif="{{!allProducts.length}}">
      <view class="state-symbol">票</view><text class="state-title">暂无可购买商品</text><text class="state-detail">当前没有已发布的门票或套餐</text><button class="retry-button compact-retry" bindtap="retry">刷新商品</button>
    </view>
    <view class="state compact" xhs:elif="{{!products.length}}">
      <view class="state-symbol muted">⌕</view><text class="state-title">没有找到匹配商品</text><text class="state-detail">{{emptyStateDetail}}</text><button class="retry-button compact-retry" bindtap="resetFilters">清除筛选</button>
    </view>
    <view class="product-list" xhs:else>
      <view class="product" xhs:for="{{products}}" xhs:key="id" data-id="{{item.id}}" bindtap="openProduct">
        <image class="product-image" xhs:if="{{item.image_url}}" src="{{item.image_url}}" mode="aspectFill" />
        <view class="product-image fallback {{item.product_kind === 'scenic_hotel_package' ? 'package' : ''}}" xhs:else><text class="fallback-small">{{item.kindLabel}}</text><text>{{item.product_kind === 'scenic_hotel_package' ? '住进风景里' : '去山里'}}</text></view>
        <view class="product-info">
          <view class="product-name-row"><text class="product-name">{{item.name}}</text><text class="product-arrow">›</text></view>
          <text class="product-scenic" xhs:if="{{item.product_kind === 'scenic_hotel_package'}}">{{item.packageSummary}}</text>
          <text class="product-scenic" xhs:elif="{{item.scenic_area_name}}">{{item.scenic_area_name}}</text>
          <view class="tag-row" xhs:if="{{item.tags.length}}">
            <text class="tag" xhs:for="{{item.tags}}" xhs:for-item="tag" xhs:key="*this">{{tag}}</text>
          </view>
          <view class="product-bottom"><view class="price"><text class="currency">¥</text><text class="amount">{{item.priceText}}</text><text class="unit">起</text></view><text class="detail-link">查看详情</text></view>
        </view>
      </view>
    </view>
    <view class="content-spacer"></view>
  </view>

  <view class="bottom-nav">
    <view class="nav-item active" bindtap="goHome"><text class="nav-icon">票</text><text class="nav-label">购票</text></view>
    <view class="nav-item" bindtap="goOrders"><text class="nav-icon">单</text><text class="nav-label">订单</text></view>
  </view>
</view>
