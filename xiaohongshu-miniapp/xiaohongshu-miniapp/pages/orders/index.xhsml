<view class="page">
  <view class="header"><text class="title">我的订单</text><text class="subtitle">查看支付结果和电子票码</text></view>
  <view class="tabs">
    <text class="tab {{activeStatus === 'all' ? 'active' : ''}}" data-status="all" bindtap="selectStatus">全部</text>
    <text class="tab {{activeStatus === 'unpaid' ? 'active' : ''}}" data-status="unpaid" bindtap="selectStatus">待支付</text>
    <text class="tab {{activeStatus === 'paid' ? 'active' : ''}}" data-status="paid" bindtap="selectStatus">已支付</text>
    <text class="tab {{activeStatus === 'closed' ? 'active' : ''}}" data-status="closed" bindtap="selectStatus">已关闭</text>
  </view>
  <view class="content">
    <view class="state" xhs:if="{{loading}}">正在加载订单...</view>
    <view class="state error" xhs:elif="{{error && !allOrders.length}}"><text>{{error}}</text><button bindtap="retry">重新加载</button></view>
    <view class="state" xhs:elif="{{!orders.length}}"><text class="state-title">暂无相关订单</text><text class="state-detail">购买门票后可在这里查看</text></view>
    <view class="order-list" xhs:else>
      <view class="order-card" xhs:for="{{orders}}" xhs:key="order_no" data-no="{{item.order_no}}" bindtap="openOrder">
        <view class="order-head"><text class="order-time">{{item.createdText}}</text><text class="status {{item.statusClass}}">{{item.statusText}}</text></view>
        <view class="order-body">
          <image class="order-image" xhs:if="{{item.image_url}}" src="{{item.image_url}}" mode="aspectFill" />
          <view class="order-image fallback" xhs:else>门票</view>
          <view class="order-info"><text class="order-name">{{item.product_name}}</text><text class="quantity">共 {{item.quantity}} 张</text><text class="order-no">订单号 {{item.order_no}}</text></view>
        </view>
        <view class="order-foot"><view><text>实付</text><text class="amount">¥{{item.amountText}}</text></view><text class="detail-link">查看详情</text></view>
      </view>
      <text class="load-more" xhs:if="{{loadingMore}}">正在加载...</text>
      <text class="load-more" xhs:elif="{{allOrders.length >= total && total > 0}}">已经到底了</text>
    </view>
    <view class="content-spacer"></view>
  </view>
  <view class="bottom-nav">
    <view class="nav-item" bindtap="goHome"><text class="nav-mark"></text><text>购票</text></view>
    <view class="nav-item active" bindtap="goOrders"><text class="nav-mark"></text><text>订单</text></view>
  </view>
</view>
