<view class="page">
  <view class="state" xhs:if="{{loading}}">正在加载票种...</view>
  <view class="state error" xhs:elif="{{error}}"><text>{{error}}</text><button bindtap="retry">重新加载</button></view>
  <view xhs:elif="{{product}}">
    <image class="hero-image" xhs:if="{{product.image_url}}" src="{{product.image_url}}" mode="aspectFill" />
    <view class="hero-image fallback" xhs:else><text>{{storeName}}</text></view>
    <view class="product-panel">
      <view class="product-meta"><text class="official-chip">官方直营</text><text class="scenic">{{product.scenic_area_name || storeName}}</text></view>
      <text class="title">{{product.name}}</text>
      <view class="tags" xhs:if="{{product.tags.length}}"><text class="tag" xhs:for="{{product.tags}}" xhs:key="*this">{{item}}</text></view>
      <view class="price"><text class="currency">¥</text><text class="amount">{{product.priceText}}</text><text class="unit">起</text></view>
    </view>
    <view class="assurances"><view><text class="assurance-title">官方出票</text><text>订单可查</text></view><view><text class="assurance-title">快速入园</text><text>电子票码</text></view><view><text class="assurance-title">售后保障</text><text>原路退款</text></view></view>
    <view class="section">
      <text class="section-title">使用说明</text>
      <view class="info-row"><text class="info-label">有效期</text><text class="info-value">{{product.validityText}}</text></view>
      <view class="info-row"><text class="info-label">入园方式</text><text class="info-value">支付成功后查看电子票码</text></view>
    </view>
    <view class="section" xhs:if="{{product.description}}">
      <text class="section-title">票种介绍</text>
      <text class="description">{{product.description}}</text>
    </view>
    <view class="page-spacer"></view>
    <view class="purchase-bar">
      <view><text class="bar-label">售价</text><text class="bar-price">¥{{product.priceText}}</text></view>
      <button class="buy-button" bindtap="buy">现在购买</button>
    </view>
  </view>
</view>
