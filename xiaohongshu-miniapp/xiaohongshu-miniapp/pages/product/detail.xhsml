<view class="page">
  <view class="loading-state" xhs:if="{{loading}}">
    <view class="loading-card"><view class="loading-media"></view><view class="loading-line wide"></view><view class="loading-line"></view><view class="loading-line short"></view></view>
    <text class="loading-copy">正在加载商品...</text>
  </view>
  <view class="state error-state" xhs:elif="{{error && !product}}"><text class="state-title">暂时无法加载商品</text><text class="state-detail">{{error}}</text><button class="retry-button" bindtap="retry">重新加载</button></view>
  <view xhs:elif="{{product}}">
    <image class="hero-image" xhs:if="{{product.image_url}}" src="{{product.image_url}}" mode="aspectFill" />
    <view class="product-panel {{product.image_url ? '' : 'without-image'}}">
      <view class="product-meta"><text class="official-chip">{{product.kindLabel}}</text><text class="scenic" xhs:if="{{product.scenic_area_name}}">{{product.scenic_area_name}}</text></view>
      <text class="title">{{product.name}}</text>
      <view class="tags" xhs:if="{{product.tags.length}}"><text class="tag" xhs:for="{{product.tags}}" xhs:key="*this">{{item}}</text></view>
      <!-- Price & Promotion Tag Row -->
      <view class="price-header-row">
        <view class="price {{product.hasPromotionPrice ? 'discounted-price' : ''}}">
          <text class="currency">¥</text>
          <text class="amount">{{product.displayPriceText}}</text>
          <text class="original-price" xhs:if="{{product.hasPromotionPrice}}">原价 ¥{{product.originalPriceText}}</text>
        </view>
        <view class="promo-tag-human" xhs:if="{{product.hasPromotionPrice}}">
          <text class="tag-brand">专享优惠</text>
          <text class="tag-val">立减 ¥{{product.promotionDiscountText}}</text>
        </view>
      </view>
      <text class="discount-note" xhs:if="{{product.hasPromotionPrice}}">本单立减 ¥{{product.promotionDiscountText}} · 购买多张也只减一次</text>

      <!-- Guarantee Card Strip (Design A) -->
      <view class="guarantee-card-human">
        <view class="guarantee-grid-human">
          <view class="guarantee-item-human">
            <view class="guarantee-badge"><text class="badge-check">✓</text></view>
            <text class="guarantee-label">未核销随时退</text>
          </view>
          <view class="guarantee-item-human">
            <view class="guarantee-badge"><text class="badge-check">✓</text></view>
            <text class="guarantee-label">过期自动原路退</text>
          </view>
          <view class="guarantee-item-human">
            <view class="guarantee-badge"><text class="badge-check">✓</text></view>
            <text class="guarantee-label">商家直营质保</text>
          </view>
          <view class="guarantee-item-human">
            <view class="guarantee-badge"><text class="badge-check">✓</text></view>
            <text class="guarantee-label">免换票刷二维码</text>
          </view>
        </view>
      </view>

      <view class="opportunity-strip product-opportunity-strip" xhs:if="{{opportunityVisible}}" bindtap="openPromotionOrder" role="button" aria-label="查看随机立减机会">
        <view xhs:if="{{opportunityReservedOrderNo}}"><text class="opportunity-title">优惠已用于待支付订单</text><text class="opportunity-copy">查看原订单</text></view>
        <view xhs:else><text class="opportunity-title">随机立减 ¥{{opportunityAmountText}}</text><text class="opportunity-copy">本商品可用 · 剩余 {{opportunityCountdown}}</text></view>
        <text class="opportunity-arrow">›</text>
      </view>
    </view>
    <view class="section" xhs:if="{{product.isPackage}}">
      <text class="section-title">套餐包含</text>
      <view class="info-row"><text class="info-label">住宿酒店</text><text class="info-value">{{product.hotel_name}}</text></view>
      <view class="info-row"><text class="info-label">房型</text><text class="info-value">{{product.room_type_name}}</text></view>
      <view class="info-row"><text class="info-label">价格方案</text><text class="info-value">{{product.rate_plan_name}}</text></view>
      <view class="info-row"><text class="info-label">住宿数量</text><text class="info-value">{{product.stayText}}</text></view>
    </view>
    <view class="section">
      <text class="section-title">{{product.isPackage ? '使用说明' : '门票说明'}}</text>
      <view class="info-row"><text class="info-label">{{product.isPackage ? '游玩与入住' : '有效期'}}</text><text class="info-value">{{product.isDeferredPackage ? '购买后预约入住日期' : (product.isPackage ? '下单时选择入住日期' : product.validityText)}}</text></view>
      <view class="info-row"><text class="info-label">入园方式</text><text class="info-value">{{product.isDeferredPackage ? '预约成功后查看电子票码' : '支付成功后查看电子票码'}}</text></view>
      <view class="info-row"><text class="info-label">退改说明</text><text class="info-value">{{product.isPackage ? '门票与住宿按整份套餐处理' : '以票种实际规则和订单状态为准'}}</text></view>
    </view>
    <view class="section" xhs:if="{{product.description}}">
      <text class="section-title">商品介绍</text>
      <text class="description">{{product.description}}</text>
    </view>
    <view class="page-spacer"></view>
    <view class="purchase-bar">
      <view class="bar-price-group"><text class="bar-label">{{product.hasPromotionPrice ? '单张立减后' : '售价'}}</text><view class="bar-price-row"><text class="bar-price">¥{{product.displayPriceText}}</text><text class="original-price" xhs:if="{{product.hasPromotionPrice}}">¥{{product.originalPriceText}}</text></view></view>
      <button class="buy-button {{navigating ? 'is-disabled' : ''}}" loading="{{navigating}}" disabled="{{navigating}}" bindtap="buy">立即选购</button>
    </view>
  </view>
</view>
