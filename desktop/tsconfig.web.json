{
    "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
    "include": [
        "src/renderer/src/env.d.ts",
        "src/renderer/src/**/*",
        "src/renderer/**/*.vue"
    ],
    "compilerOptions": {
        "composite": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
        "baseUrl": ".",
        "paths": {
            "@renderer/*": [
                "src/renderer/src/*"
            ]
        }
    }
}
