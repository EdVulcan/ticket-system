<view class="page-shell address-list-page">
  <view class="address-heading"><view class="section-title">{{title}}</view><view class="muted-text">{{type === 'SHIPPING' ? '用于零售商品快递寄送' : type === 'DELIVERY' || type === 'CAMPUS' ? '用于餐饮本地配送' : '配送地址与快递地址分开管理'}}</view></view>
  <view wx:if="{{addresses.length}}" class="address-list"><view wx:for="{{addresses}}" wx:key="id" class="address-card card" data-id="{{item.id}}" bindtap="selectAddress"><view class="address-kind {{item.addressType === 'SHIPPING' ? 'address-kind--shipping' : ''}}">{{item.addressType === 'SHIPPING' ? '快递地址' : '配送地址'}}</view><view class="address-card-main"><view class="address-card-top"><text class="address-card-name">{{item.contactName}}</text><text class="address-card-phone">{{item.contactPhone}}</text><text wx:if="{{item.isDefault}}" class="default-label">默认</text></view><view class="address-card-detail">{{item.displayText}}</view><view wx:if="{{item.remark}}" class="address-card-remark">备注：{{item.remark}}</view></view><view class="address-card-actions"><view class="edit-address" data-id="{{item.id}}" catchtap="editAddress">编辑</view><view class="delete-address" data-id="{{item.id}}" catchtap="deleteAddress">删除</view></view></view></view>
  <view class="address-add-card card" bindtap="addAddress"><view class="address-add-icon">+</view><view>新增{{type === 'SHIPPING' ? '快递' : type === 'DELIVERY' || type === 'CAMPUS' ? '配送' : ''}}收货地址</view></view>
  <view class="address-tip">餐饮配送使用配送地址；零售商品使用快递地址。两类地址分别维护默认地址。</view>
</view>
