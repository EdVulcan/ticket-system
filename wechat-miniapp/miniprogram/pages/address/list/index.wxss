@import "../../../styles/common.wxss";

.address-list-page { padding: 28rpx 30rpx 48rpx; }
.address-heading { margin-bottom: 20rpx; }
.address-heading .section-title { margin-bottom: 8rpx; }
.address-list { border-radius: 24rpx; padding: 0 24rpx; }
.address-card { padding: 24rpx 0; }
.address-card + .address-card { border-top: 1rpx solid var(--line); }
.address-card--disabled { background: #f1f2ef; }
.address-card--disabled .address-card-main { opacity: .62; }
.address-card-main { min-width: 0; }
.address-card-top { align-items: center; display: flex; flex-wrap: wrap; gap: 8rpx 16rpx; }
.address-card-name { color: var(--ink); font-size: 29rpx; font-weight: 600; }
.address-card-phone { color: #6f786f; font-size: 23rpx; }
.default-label { background: var(--paper); border-radius: 6rpx; color: var(--green); flex-shrink: 0; font-size: 19rpx; padding: 4rpx 8rpx; }
.address-card-detail { color: #687268; font-size: 25rpx; line-height: 1.55; margin-top: 14rpx; overflow-wrap: anywhere; }
.address-card-remark { color: var(--muted); font-size: 21rpx; margin-top: 8rpx; }
.address-unavailable { color: var(--red); font-size: 21rpx; margin-top: 10rpx; }
.address-card-actions { border-top: 1rpx solid var(--line); display: flex; justify-content: flex-end; margin-top: 18rpx; padding-top: 16rpx; }
.edit-address, .delete-address { color: #778078; font-size: 22rpx; margin-left: 28rpx; }
.delete-address { color: var(--red); }
.address-add-card { align-items: center; border-radius: 24rpx; color: var(--green); display: flex; font-size: 26rpx; justify-content: center; margin-top: 18rpx; padding: 26rpx; }
.address-add-icon { align-items: center; border: 2rpx solid var(--muted); border-radius: 50%; display: flex; font-size: 30rpx; height: 44rpx; justify-content: center; margin-right: 12rpx; width: 44rpx; }
