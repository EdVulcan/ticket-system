<view class="page-shell address-edit-page">
  <view class="form-card card">
    <view class="form-group"><view class="form-label">省 / 市 / 区</view><picker mode="region" value="{{regionValue}}" bindchange="selectRegion"><view class="form-input region-picker {{regionText ? '' : 'region-picker--placeholder'}}">{{regionText || '请选择省 / 市 / 区'}}</view></picker></view>
    <view class="form-group"><view class="form-label">详细地址</view><input class="form-input" value="{{form.detailAddress}}" placeholder="街道、门牌号、小区和房间" data-field="detailAddress" bindinput="onInput" /></view>
    <view wx:if="{{form.addressType === 'CAMPUS'}}" class="legacy-address-tip">这是旧版地址记录；补充上面的省市区和详细地址后，会自动转换为通用收货地址。</view>
    <view wx:if="{{form.addressType === 'CAMPUS'}}" class="form-group"><view class="form-label">旧版区域（可选）</view><input class="form-input" value="{{form.campusName}}" placeholder="原区域" data-field="campusName" bindinput="onInput" /></view>
    <view wx:if="{{form.addressType === 'CAMPUS'}}" class="form-group"><view class="form-label">旧版配送区域（可选）</view><input class="form-input" value="{{form.zoneName}}" placeholder="原配送区域" data-field="zoneName" bindinput="onInput" /></view>
    <view wx:if="{{form.addressType === 'CAMPUS'}}" class="form-row"><view class="form-group form-group--half"><view class="form-label">楼栋（可选）</view><input class="form-input" value="{{form.building}}" placeholder="楼栋" data-field="building" bindinput="onInput" /></view><view class="form-group form-group--half"><view class="form-label">房间号（可选）</view><input class="form-input" value="{{form.room}}" placeholder="房间号" data-field="room" bindinput="onInput" /></view></view>
    <view class="form-row"><view class="form-group form-group--half"><view class="form-label">联系人</view><input class="form-input" value="{{form.contactName}}" placeholder="请输入姓名" data-field="contactName" bindinput="onInput" /></view><view class="form-group form-group--half"><view class="form-label">手机号</view><input class="form-input" value="{{form.contactPhone}}" type="number" maxlength="11" placeholder="请输入手机号" data-field="contactPhone" bindinput="onInput" /></view></view>
    <view class="form-group"><view class="form-label">备注</view><input class="form-input" value="{{form.remark}}" placeholder="例如：放在楼下门口 / 放前台" data-field="remark" bindinput="onInput" /></view>
  </view>
  <view class="save-tip">这个地址可同时用于餐饮配送和零售快递；餐饮配送范围由门店配置决定。</view><button class="primary-button save-address" bindtap="saveAddress" disabled="{{saving}}" loading="{{saving}}">保存地址</button>
</view>
