<view class="page-shell address-edit-page">
  <view class="form-card card"><view class="form-group"><view class="form-label">地址用途</view><picker range="{{addressTypes}}" range-key="name" value="{{typeIndex}}" bindchange="selectType"><view class="form-input">{{addressTypes[typeIndex].name}}</view></picker></view>
    <view wx:if="{{form.addressType === 'DELIVERY' || form.addressType === 'SHIPPING'}}" class="form-group"><view class="form-label">省 / 市 / 区</view><view class="form-row"><input class="form-input form-group--third" value="{{form.province}}" placeholder="省" data-field="province" bindinput="onInput" /><input class="form-input form-group--third" value="{{form.city}}" placeholder="城市" data-field="city" bindinput="onInput" /><input class="form-input form-group--third" value="{{form.district}}" placeholder="区县" data-field="district" bindinput="onInput" /></view></view>
    <view wx:if="{{form.addressType === 'DELIVERY' || form.addressType === 'SHIPPING'}}" class="form-group"><view class="form-label">详细地址</view><input class="form-input" value="{{form.detailAddress}}" placeholder="街道、门牌号、小区和房间" data-field="detailAddress" bindinput="onInput" /></view>
    <view wx:if="{{form.addressType === 'CAMPUS'}}" class="form-group"><view class="form-label">历史配送区域</view><input class="form-input" value="{{form.campusName}}" placeholder="区域" data-field="campusName" bindinput="onInput" /></view>
    <view wx:if="{{form.addressType === 'CAMPUS'}}" class="form-group"><view class="form-label">历史区域名称</view><input class="form-input" value="{{form.zoneName}}" placeholder="配送区域" data-field="zoneName" bindinput="onInput" /></view>
    <view wx:if="{{form.addressType === 'CAMPUS'}}" class="form-row"><view class="form-group form-group--half"><view class="form-label">楼栋</view><input class="form-input" value="{{form.building}}" placeholder="楼栋" data-field="building" bindinput="onInput" /></view><view class="form-group form-group--half"><view class="form-label">房间号</view><input class="form-input" value="{{form.room}}" placeholder="房间号" data-field="room" bindinput="onInput" /></view></view>
    <view class="form-row"><view class="form-group form-group--half"><view class="form-label">联系人</view><input class="form-input" value="{{form.contactName}}" placeholder="怎么称呼" data-field="contactName" bindinput="onInput" /></view><view class="form-group form-group--half"><view class="form-label">手机号</view><input class="form-input" value="{{form.contactPhone}}" type="number" maxlength="11" placeholder="联系电话" data-field="contactPhone" bindinput="onInput" /></view></view>
    <view class="form-group"><view class="form-label">备注</view><input class="form-input" value="{{form.remark}}" placeholder="例如：放在楼下门口 / 放前台" data-field="remark" bindinput="onInput" /></view>
  </view>
  <view class="save-tip">配送地址用于本地配送；快递地址用于商品寄送。两类地址分别维护默认地址。</view><button class="primary-button save-address" bindtap="saveAddress" disabled="{{saving}}" loading="{{saving}}">保存地址</button>
</view>
