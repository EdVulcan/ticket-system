<view class="page-shell checkout-page">
  <view class="checkout-title"><view class="section-title">确认订单</view><view wx:if="{{!directPurchase}}" class="muted-text">餐饮和零售会分别下单</view></view>
  <view wx:if="{{preOrderContact}}" class="private-domain-card" bindtap="openPreOrderContact" role="button" aria-label="添加店家微信">
    <view class="private-domain-avatar"><image src="/images/theme/rabbit-pair.svg" mode="aspectFit" /></view>
    <view class="private-domain-copy">
      <view class="private-domain-title">加店家微信</view>
      <view class="private-domain-sub">了解新品和店铺活动</view>
    </view>
    <view class="private-domain-action">添加 <text>›</text></view>
  </view>

  <view class="checkout-content-panel">
    <view wx:if="{{hasTakeaway}}" class="fulfillment-block"><view class="fulfillment-heading"><view><view class="fulfillment-title">餐饮订单</view><view class="fulfillment-subtitle">配送或到店自取</view></view></view>
      <view class="method-switch"><view wx:if="{{!production || !deliveryOptions.restaurant || deliveryOptions.restaurant.config.deliveryEnabled}}" class="method-item {{takeawayDeliveryMethod === 'DELIVERY' ? 'method-item--active' : ''}}" data-method="DELIVERY" bindtap="toggleDeliveryMethod">配送到家</view><view wx:if="{{!production || !deliveryOptions.restaurant || deliveryOptions.restaurant.config.pickupEnabled}}" class="method-item {{takeawayDeliveryMethod === 'PICKUP' ? 'method-item--active' : ''}}" data-method="PICKUP" bindtap="toggleDeliveryMethod">门店自提</view></view>
      <view wx:if="{{takeawayDeliveryMethod === 'DELIVERY'}}" class="address-card card" data-type="DELIVERY" bindtap="chooseAddress"><view class="address-pin"><image class="ui-icon" src="/images/theme/pin.svg" /></view><view class="address-main" wx:if="{{takeawayAddress}}"><view class="address-top"><text class="address-name">{{takeawayAddress.contactName}}</text><text class="address-phone">{{takeawayAddress.contactPhone}}</text><text wx:if="{{takeawayAddress.isDefault}}" class="default-label">默认</text></view><view class="address-detail">{{takeawayAddress.displayText}}</view></view><view wx:else class="address-main address-empty">请选择收货地址</view><view class="address-arrow"><image class="ui-icon ui-icon--small" src="/images/theme/chevron.svg" /></view></view>
      <view wx:if="{{takeawayDeliveryMethod === 'DELIVERY' && production}}" class="delivery-choice card"><view wx:if="{{restaurantZoneIndex >= 0}}" class="delivery-choice-row"><text>配送区域</text><view class="delivery-value">{{restaurantZoneNames[restaurantZoneIndex]}}</view></view><view wx:elif="{{restaurantZones.length}}" class="delivery-choice-row delivery-choice-row--notice"><text>配送区域</text><text>当前地址不在配送范围内</text></view><view wx:else class="delivery-choice-row delivery-choice-row--notice"><text>配送区域</text><text>门店暂未配置</text></view><view wx:if="{{restaurantSlots.length}}" class="delivery-choice-row"><text>配送时段</text><picker class="delivery-picker" range="{{restaurantSlotNames}}" value="{{restaurantSlotIndex}}" bindchange="selectDeliverySlot"><view>{{restaurantSlotNames[restaurantSlotIndex] || '请选择时段'}}</view></picker></view><view wx:elif="{{restaurantZones.length}}" class="delivery-choice-row delivery-choice-row--notice"><text>配送时段</text><text>请先更换配送地址</text></view><view wx:else class="delivery-choice-row delivery-choice-row--notice"><text>配送时段</text><text>门店暂未配置</text></view><view wx:if="{{restaurantSlots.length}}" class="delivery-choice-row"><text>配送日期</text><picker class="delivery-picker" mode="date" value="{{restaurantSlotDate}}" start="{{restaurantSlotDateMin}}" end="{{restaurantSlotDateMax}}" bindchange="selectSlotDate"><view>{{restaurantSlotDate || '请选择日期'}}</view></picker></view><view class="delivery-choice-help">配送区域由收货地址自动匹配，用于计算跑腿费和起送价</view></view>
      <view wx:if="{{takeawayDeliveryMethod === 'PICKUP'}}" class="pickup-card"><image class="ui-icon" src="/images/theme/store.svg" /><view><view>到店自取</view><text>{{store.locationName || store.name || brand.name}} · {{store.phone || '请联系门店确认取餐'}}</text></view></view>
      <view class="checkout-section"><view class="checkout-section-title">餐饮菜单 <text>{{takeawayItems.length}} 件</text></view><view wx:for="{{takeawayItems}}" wx:key="cartKey" class="checkout-item"><view class="checkout-item-icon" style="background: {{item.color}};"><image wx:if="{{item.coverImageUrl}}" class="food-photo" mode="aspectFill" src="{{item.coverImageUrl}}" /><image wx:else class="ui-icon" src="/images/theme/bowl.svg" /></view><view class="checkout-item-copy"><view>{{item.name}} × {{item.quantity}}</view><view wx:if="{{item.optionsText}}" class="muted-text">{{item.optionsText}}</view></view><view class="checkout-item-price">¥{{item.subtotalText}}</view></view><view class="customer-remark"><view class="checkout-section-title">餐饮备注</view><input value="{{customerRemark}}" maxlength="80" placeholder="例如：少辣、放门口、不要餐具" data-field="customerRemark" bindinput="onRemarkInput" /></view><view class="summary-row"><text>商品小计</text><text>¥{{takeawayGoodsText}}</text></view><view class="summary-row"><text wx:if="{{takeawayDeliveryMethod === 'PICKUP'}}">取餐方式</text><text wx:else>配送费 <text class="fee-note">{{takeawayAddress ? takeawayAddress.displayText : '待选择区域'}}</text></text><text wx:if="{{takeawayDeliveryMethod === 'PICKUP'}}">门店自取</text><text wx:else>¥{{takeawayFeeText}}</text></view></view>
  </view>

  <view wx:if="{{hasCourier}}" class="fulfillment-block fulfillment-block--courier"><view class="fulfillment-heading"><view><view class="fulfillment-title">零售订单</view><view class="fulfillment-subtitle">快递发货</view></view></view><view class="address-card card" data-type="SHIPPING" bindtap="chooseAddress"><view class="address-pin address-pin--red"><image class="ui-icon" src="/images/theme/truck.svg" /></view><view class="address-main" wx:if="{{courierAddress}}"><view class="address-top"><text class="address-name">{{courierAddress.contactName}}</text><text class="address-phone">{{courierAddress.contactPhone}}</text><text wx:if="{{courierAddress.isDefault}}" class="default-label">默认</text></view><view class="address-detail">{{courierAddress.province}} {{courierAddress.city}} {{courierAddress.district}} {{courierAddress.detailAddress}}</view></view><view wx:else class="address-main address-empty">请选择收货地址</view><view class="address-arrow"><image class="ui-icon ui-icon--small" src="/images/theme/chevron.svg" /></view></view><view class="checkout-section"><view class="checkout-section-title">零售商品 <text>{{courierItems.length}} 件</text></view><view wx:for="{{courierItems}}" wx:key="cartKey" class="checkout-item"><view class="checkout-item-icon checkout-item-icon--red" style="background: {{item.color}};"><image wx:if="{{item.coverImageUrl}}" class="food-photo" mode="aspectFill" src="{{item.coverImageUrl}}" /><image wx:else class="ui-icon" src="/images/theme/snack.svg" /></view><view class="checkout-item-copy"><view>{{item.name}} × {{item.quantity}}</view><view wx:if="{{item.optionsText}}" class="muted-text">{{item.optionsText}}</view></view><view class="checkout-item-price">¥{{item.subtotalText}}</view></view><view class="customer-remark"><view class="checkout-section-title">快递备注</view><input value="{{courierRemark}}" maxlength="80" placeholder="例如：工作日送达、放前台" data-field="courierRemark" bindinput="onRemarkInput" /></view><view class="summary-row"><text>商品小计</text><text>¥{{courierGoodsText}}</text></view><view class="summary-row"><text>快递费</text><text>¥{{courierFeeText}}</text></view></view>
  </view>

  <view class="checkout-section checkout-summary"><view class="coupon-row" bindtap="openCouponSheet"><view><text>优惠券</text><text wx:if="{{selectedCoupon}}" class="coupon-name">{{selectedCoupon.name}} · 用于{{couponTarget === 'COURIER' ? '零售' : '餐饮'}}</text></view><view wx:if="{{selectedCoupon}}" class="coupon-discount">-¥{{discountText}} ›</view><view wx:elif="{{couponsUnavailable}}" class="muted-text">暂未开放</view><view wx:else class="muted-text">选择优惠券 ›</view></view><view class="summary-row summary-total"><text>应付金额</text><text>¥{{payableText}}</text></view></view>
  <view class="pay-note"><text>●</text> {{paymentModeText}}</view>
  </view>
  <view class="bottom-space"></view><view class="pay-bar"><view><view class="pay-label">应付 <text>¥{{payableText}}</text></view><view class="pay-sub">{{pricingNote}}</view></view><button class="primary-button pay-button" bindtap="submitOrder" disabled="{{paying}}">{{paying ? '提交中…' : '提交并支付'}}</button></view>

  <view wx:if="{{showCouponSheet || couponSheetClosing}}" class="sheet-mask {{showCouponSheet ? 'sheet-mask--visible' : 'sheet-mask--closing'}}" catchtap="closeCouponSheet"><view class="coupon-sheet" catchtap="stopPropagation"><view class="sheet-header"><view class="sheet-title">选择优惠券</view><view class="sheet-close" bindtap="closeCouponSheet" role="button" aria-label="关闭">×</view></view><view wx:if="{{hasTakeaway && hasCourier}}" class="coupon-target"><view class="coupon-target-label">优惠券用于</view><view class="coupon-target-row"><view class="coupon-target-item {{couponTarget === 'TAKEAWAY' ? 'coupon-target-item--active' : ''}}" data-target="TAKEAWAY" bindtap="chooseCouponTarget">餐饮订单</view><view class="coupon-target-item {{couponTarget === 'COURIER' ? 'coupon-target-item--active' : ''}}" data-target="COURIER" bindtap="chooseCouponTarget">零售订单</view></view></view><view class="coupon-option coupon-option--plain {{!selectedCoupon ? 'coupon-option--selected' : ''}}" data-id="" bindtap="chooseCoupon"><view class="coupon-copy"><view>暂不使用优惠券</view><view>按订单原价结算</view></view><view class="coupon-check">{{!selectedCoupon ? '✓' : ''}}</view></view><view wx:for="{{coupons}}" wx:key="id" class="coupon-option {{selectedCoupon && selectedCoupon.id === item.id ? 'coupon-option--selected' : ''}}" data-id="{{item.id}}" bindtap="chooseCoupon"><view class="coupon-amount"><text>¥</text>{{item.discountAmount / 100}}</view><view class="coupon-copy"><view>{{item.name}}</view><view>{{item.description}}</view></view><view class="coupon-check">{{selectedCoupon && selectedCoupon.id === item.id ? '✓' : ''}}</view></view><view wx:if="{{!coupons.length}}" class="sheet-empty">暂无可用优惠券</view></view></view>
  <view wx:if="{{preOrderContact && (showPreOrderContact || preOrderContactClosing)}}" class="pre-contact-overlay {{showPreOrderContact ? 'pre-contact-overlay--visible' : 'pre-contact-overlay--closing'}}" bindtap="closePreOrderContact">
    <view class="pre-contact-card" catchtap="keepPreOrderContactOpen">
      <view class="pre-contact-close" bindtap="closePreOrderContact" role="button" aria-label="关闭">×</view>
      <view class="pre-contact-title">加店家微信</view>
      <view class="pre-contact-sub">了解新品与店铺活动</view>
      <view class="pre-contact-qr-wrap" bindtap="previewPreOrderContactQRCode" role="button" aria-label="查看店家二维码大图"><image class="pre-contact-qr" src="{{preOrderContact.qrCodeUrl}}" mode="aspectFit" show-menu-by-longpress /></view>
      <view class="pre-contact-sub">长按二维码识别添加</view>
      <view wx:if="{{preOrderContact.wechatId}}" class="pre-contact-wechat" bindtap="copyPreOrderContactWechat" role="button" aria-label="复制微信号"><text>微信号：{{preOrderContact.wechatId}}</text><text class="pre-contact-copy-hint">点击复制</text></view>
      <view class="pre-contact-actions"><button class="pre-contact-later" bindtap="closePreOrderContact">知道了</button></view>
    </view>
  </view>
</view>
