<view class="page-shell checkout-page">
  <view class="checkout-title"><view class="section-title">确认订单</view><view class="muted-text">餐饮与零售会生成关联订单，分别履约</view></view>

  <view wx:if="{{hasTakeaway}}" class="fulfillment-block"><view class="fulfillment-heading"><view><view class="fulfillment-title">餐饮配送</view><view class="fulfillment-subtitle">门店现制 · 配送到家或到店自取</view></view><view class="fulfillment-badge">餐饮</view></view>
    <view class="method-switch"><view wx:if="{{!production || !deliveryOptions.restaurant || deliveryOptions.restaurant.config.deliveryEnabled}}" class="method-item {{takeawayDeliveryMethod === 'DELIVERY' ? 'method-item--active' : ''}}" data-method="DELIVERY" bindtap="toggleDeliveryMethod">配送到家</view><view wx:if="{{!production || !deliveryOptions.restaurant || deliveryOptions.restaurant.config.pickupEnabled}}" class="method-item {{takeawayDeliveryMethod === 'PICKUP' ? 'method-item--active' : ''}}" data-method="PICKUP" bindtap="toggleDeliveryMethod">门店自提</view></view>
    <view wx:if="{{takeawayDeliveryMethod === 'DELIVERY'}}" class="address-card card" data-type="DELIVERY" bindtap="chooseAddress"><view class="address-pin"><image class="ui-icon" src="/images/theme/pin.svg" /></view><view class="address-main" wx:if="{{takeawayAddress}}"><view class="address-top"><text class="address-name">{{takeawayAddress.contactName}}</text><text class="address-phone">{{takeawayAddress.contactPhone}}</text><text wx:if="{{takeawayAddress.isDefault}}" class="default-label">默认</text></view><view class="address-detail">{{takeawayAddress.displayText}}</view></view><view wx:else class="address-main address-empty">请选择配送地址</view><view class="address-arrow"><image class="ui-icon ui-icon--small" src="/images/theme/chevron.svg" /></view></view>
    <view wx:if="{{takeawayDeliveryMethod === 'DELIVERY' && production && restaurantZones.length}}" class="delivery-choice card"><view class="delivery-choice-row"><text>配送区域</text><picker class="delivery-picker" range="{{restaurantZoneNames}}" value="{{restaurantZoneIndex}}" bindchange="selectDeliveryZone"><view>{{restaurantZoneNames[restaurantZoneIndex] || '请选择区域'}}</view></picker></view><view class="delivery-choice-row"><text>配送时段</text><picker class="delivery-picker" range="{{restaurantSlotNames}}" value="{{restaurantSlotIndex}}" bindchange="selectDeliverySlot"><view>{{restaurantSlotNames[restaurantSlotIndex] || '请选择时段'}}</view></picker></view><view class="delivery-choice-row"><text>配送日期</text><picker class="delivery-picker" mode="date" value="{{restaurantSlotDate}}" start="{{restaurantSlotDateMin}}" end="{{restaurantSlotDateMax}}" bindchange="selectSlotDate"><view>{{restaurantSlotDate || '请选择日期'}}</view></picker></view></view>
    <view wx:else class="pickup-card"><image class="ui-icon" src="/images/theme/store.svg" /><view><view>到店自取</view><text>{{store.name || brand.name}} · {{store.phone || '请联系门店确认取餐'}}</text></view></view>
    <view class="checkout-section"><view class="checkout-section-title">餐饮菜单 <text>{{takeawayItems.length}} 件</text></view><view wx:for="{{takeawayItems}}" wx:key="cartKey" class="checkout-item"><view class="checkout-item-icon" style="background: {{item.color}};"><image wx:if="{{item.coverImageUrl}}" class="food-photo" mode="aspectFill" src="{{item.coverImageUrl}}" /><image wx:else class="ui-icon" src="/images/theme/bowl.svg" /></view><view class="checkout-item-copy"><view>{{item.name}} × {{item.quantity}}</view><view wx:if="{{item.optionsText}}" class="muted-text">{{item.optionsText}}</view></view><view class="checkout-item-price">¥{{item.subtotalText}}</view></view><view class="customer-remark"><view class="checkout-section-title">餐饮备注</view><input value="{{customerRemark}}" maxlength="80" placeholder="例如：少辣、放门口、不要餐具" data-field="customerRemark" bindinput="onRemarkInput" /></view><view class="summary-row"><text>商品小计</text><text>¥{{takeawayGoodsText}}</text></view><view class="summary-row"><text>配送费 <text class="fee-note">{{takeawayDeliveryMethod === 'PICKUP' ? '门店自取' : (takeawayAddress ? takeawayAddress.displayText : '待选择区域')}}</text></text><text>¥{{takeawayFeeText}}</text></view></view>
  </view>

  <view wx:if="{{hasCourier}}" class="fulfillment-block fulfillment-block--courier"><view class="fulfillment-heading"><view><view class="fulfillment-title">零售快递</view><view class="fulfillment-subtitle">商品打包 · 快递送达</view></view><view class="fulfillment-badge fulfillment-badge--red">零售</view></view><view class="address-card card" data-type="SHIPPING" bindtap="chooseAddress"><view class="address-pin address-pin--red"><image class="ui-icon" src="/images/theme/truck.svg" /></view><view class="address-main" wx:if="{{courierAddress}}"><view class="address-top"><text class="address-name">{{courierAddress.contactName}}</text><text class="address-phone">{{courierAddress.contactPhone}}</text><text wx:if="{{courierAddress.isDefault}}" class="default-label">默认</text></view><view class="address-detail">{{courierAddress.province}} {{courierAddress.city}} {{courierAddress.district}} {{courierAddress.detailAddress}}</view></view><view wx:else class="address-main address-empty">请选择快递地址</view><view class="address-arrow"><image class="ui-icon ui-icon--small" src="/images/theme/chevron.svg" /></view></view><view class="checkout-section"><view class="checkout-section-title">零售商品 <text>{{courierItems.length}} 件</text></view><view wx:for="{{courierItems}}" wx:key="cartKey" class="checkout-item"><view class="checkout-item-icon checkout-item-icon--red" style="background: {{item.color}};"><image wx:if="{{item.coverImageUrl}}" class="food-photo" mode="aspectFill" src="{{item.coverImageUrl}}" /><image wx:else class="ui-icon" src="/images/theme/snack.svg" /></view><view class="checkout-item-copy"><view>{{item.name}} × {{item.quantity}}</view><view wx:if="{{item.optionsText}}" class="muted-text">{{item.optionsText}}</view></view><view class="checkout-item-price">¥{{item.subtotalText}}</view></view><view class="customer-remark"><view class="checkout-section-title">快递备注</view><input value="{{courierRemark}}" maxlength="80" placeholder="例如：工作日送达、放前台" data-field="courierRemark" bindinput="onRemarkInput" /></view><view class="summary-row"><text>商品小计</text><text>¥{{courierGoodsText}}</text></view><view class="summary-row"><text>快递费</text><text>¥{{courierFeeText}}</text></view></view>
  </view>

  <view class="checkout-section checkout-summary"><view class="coupon-row" bindtap="openCouponSheet"><view><text>优惠券</text><text wx:if="{{selectedCoupon}}" class="coupon-name">{{selectedCoupon.name}} · 用于{{couponTarget === 'COURIER' ? '零售' : '餐饮'}}</text></view><view wx:if="{{selectedCoupon}}" class="coupon-discount">-¥{{discountText}} ›</view><view wx:elif="{{couponsUnavailable}}" class="muted-text">暂未开放</view><view wx:else class="muted-text">选择优惠券 ›</view></view><view class="summary-row summary-total"><text>应付金额</text><text>¥{{payableText}}</text></view></view>
  <view class="pay-note"><text>●</text> {{paymentModeText}}</view><view class="bottom-space"></view><view class="pay-bar"><view><view class="pay-label">应付 <text>¥{{payableText}}</text></view><view class="pay-sub">{{pricingNote}}</view></view><button class="primary-button pay-button" bindtap="submitOrder" disabled="{{paying}}">{{paying ? '提交中…' : '提交并支付'}}</button></view>

  <view wx:if="{{showCouponSheet}}" class="sheet-mask" catchtap="closeCouponSheet"><view class="coupon-sheet" catchtap="stopPropagation"><view class="sheet-header"><view class="sheet-title">选择优惠券</view><view class="sheet-close" bindtap="closeCouponSheet" role="button" aria-label="关闭">×</view></view><view wx:if="{{hasTakeaway && hasCourier}}" class="coupon-target"><view class="coupon-target-label">优惠券用于</view><view class="coupon-target-row"><view class="coupon-target-item {{couponTarget === 'TAKEAWAY' ? 'coupon-target-item--active' : ''}}" data-target="TAKEAWAY" bindtap="chooseCouponTarget">餐饮订单</view><view class="coupon-target-item {{couponTarget === 'COURIER' ? 'coupon-target-item--active' : ''}}" data-target="COURIER" bindtap="chooseCouponTarget">零售订单</view></view></view><view class="coupon-option coupon-option--plain {{!selectedCoupon ? 'coupon-option--selected' : ''}}" data-id="" bindtap="chooseCoupon"><view class="coupon-copy"><view>暂不使用优惠券</view><view>按订单原价结算</view></view><view class="coupon-check">{{!selectedCoupon ? '✓' : ''}}</view></view><view wx:for="{{coupons}}" wx:key="id" class="coupon-option {{selectedCoupon && selectedCoupon.id === item.id ? 'coupon-option--selected' : ''}}" data-id="{{item.id}}" bindtap="chooseCoupon"><view class="coupon-amount"><text>¥</text>{{item.discountAmount / 100}}</view><view class="coupon-copy"><view>{{item.name}}</view><view>{{item.description}}</view></view><view class="coupon-check">{{selectedCoupon && selectedCoupon.id === item.id ? '✓' : ''}}</view></view><view wx:if="{{!coupons.length}}" class="sheet-empty">暂无可用优惠券</view></view></view>
</view>
