@import "../../../styles/common.wxss";

.product-edit-page { padding-top: 32rpx; }
.form-textarea { background: var(--paper); border-radius: 14rpx; box-sizing: border-box; color: var(--ink); font-size: 24rpx; min-height: 150rpx; padding: 18rpx; width: 100%; }
.save-address { margin-top: 28rpx; }
.product-photo { width: 100%; height: 320rpx; border-radius: 16rpx; margin-bottom: 18rpx; }
.option-group-editor { border-top: 1rpx solid var(--line); margin-top: 24rpx; padding-top: 26rpx; }
.option-editor { align-items: center; display: flex; gap: 12rpx; margin-top: 16rpx; }
.option-editor-fields { display: grid; flex: 1; gap: 12rpx; grid-template-columns: minmax(0, 1fr) minmax(0, .72fr); min-width: 0; }
.option-remove { align-items: center; background: var(--red-soft); border-radius: 10rpx; color: var(--red); display: flex; flex-shrink: 0; font-size: 34rpx; height: 64rpx; justify-content: center; width: 64rpx; }
.option-group-actions { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 20rpx; }
.option-group-actions .outline-button { flex: 1 1 220rpx; margin: 0; min-width: 0; }
.option-group-remove { border-color: #d9b7b2; color: var(--red); }

@media (max-width: 360px) {
  .option-editor { align-items: flex-start; }
  .option-editor-fields { grid-template-columns: 1fr; }
}
