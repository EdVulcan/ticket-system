<view class="page-shell merchant-page">
  <view wx:if="{{merchantUnavailable}}" class="save-tip">商家管理接口暂未接入，生产环境不会展示本地演示订单或提供写操作。</view>
  <view class="merchant-header"><view><view class="merchant-title">店主工作台</view><view class="merchant-date">今天也要把每一单做好</view></view><view class="merchant-avatar">店</view></view>
  <view class="stats-grid"><view class="stat-card"><view class="stat-label">今日订单净额</view><view class="stat-value">¥{{stats.salesText}}</view><view class="stat-foot">最近100单 · 不含未付及退款中</view></view><view class="stat-card"><view class="stat-label">待处理订单</view><view class="stat-value">{{stats.pending}}</view><view class="stat-foot stat-foot--orange">外卖接单 / 冷吃发货</view></view></view>
  <view class="merchant-shortcuts"><view wx:if="{{canProducts}}" class="shortcut-item" bindtap="goProducts"><view class="shortcut-icon shortcut-icon--green"><image class="ui-icon" src="/images/theme/store.svg" /></view><view>商品管理</view><text>上下架 / 库存 / 履约</text></view><view wx:if="{{canSettings}}" class="shortcut-item" bindtap="goSettings"><view class="shortcut-icon shortcut-icon--orange"><image class="ui-icon" src="/images/theme/settings.svg" /></view><view>店铺设置</view><text>营业 / 配送 / 快递</text></view><view wx:if="{{canSettings}}" class="shortcut-item" bindtap="goCampaign"><view class="shortcut-icon shortcut-icon--dark"><image class="ui-icon" src="/images/theme/rabbit-pair.svg" /></view><view>助力活动</view><text>优惠券规则</text></view></view>
  <view class="merchant-more-links"><view wx:if="{{canSettings}}" bindtap="goCoupons">优惠券模板 ›</view><view wx:if="{{canOrders}}" bindtap="goStats">数据统计 ›</view><view wx:if="{{canOrders && notificationConfigured}}" bindtap="requestOrderNotice">开启新订单提醒 ›</view></view>
  <view class="merchant-section-head"><view class="section-title">订单处理</view><view class="merchant-refresh" bindtap="loadOrders">刷新</view></view><scroll-view scroll-x class="merchant-tabs" show-scrollbar="{{false}}"><view class="merchant-tabs-row"><view wx:for="{{tabs}}" wx:key="id" class="merchant-tab {{activeTab === item.id ? 'merchant-tab--active' : ''}}" data-id="{{item.id}}" bindtap="selectTab">{{item.name}}<text wx:if="{{item.count}}">{{item.count}}</text></view></view></scroll-view>
<view wx:if="{{filteredOrders.length}}" class="merchant-orders"><view wx:for="{{filteredOrders}}" wx:key="id" class="merchant-order card"><view class="merchant-order-head"><view><view class="merchant-order-kind">{{item.fulfillmentText}}</view><view class="merchant-order-no">#{{item.orderNo}}</view><view class="merchant-order-time">{{item.createdText}} · {{item.itemCount}} 件</view></view><view class="order-status order-status--{{item.status}}">{{item.statusText}}</view></view><view class="merchant-order-items">{{item.itemsText}}</view><view wx:if="{{item.fulfillmentType === 'COURIER'}}" class="merchant-order-items">收货：{{item.addressSnapshot.contactName}} · {{item.addressSnapshot.contactPhone}}<view>{{item.addressSnapshot.province}} {{item.addressSnapshot.city}} {{item.addressSnapshot.district}} {{item.addressSnapshot.detailAddress}}</view></view><view wx:elif="{{item.deliveryMethod === 'PICKUP'}}" class="merchant-order-items">取餐方式：门店自提</view><view wx:else class="merchant-order-items">配送：{{item.addressSnapshot.campusName}} · {{item.addressSnapshot.zoneName}} · {{item.addressSnapshot.building}} · {{item.addressSnapshot.room}}</view><view wx:if="{{item.fulfillmentType !== 'COURIER'}}" class="merchant-order-items" data-phone="{{item.addressSnapshot.contactPhone}}" bindtap="callCustomer">{{item.addressSnapshot.contactName}} · {{item.addressSnapshot.contactPhone}}（拨打）</view><view wx:if="{{item.fulfillmentType === 'COURIER' && item.status === 'PAID'}}" class="shipping-editor"><input value="{{item.shipping.carrier}}" placeholder="快递公司" data-id="{{item.id}}" data-field="carrier" bindinput="onShippingInput" /><input value="{{item.shipping.trackingNo}}" placeholder="快递单号" data-id="{{item.id}}" data-field="trackingNo" bindinput="onShippingInput" /></view><view wx:if="{{item.status === 'PREPARING' && item.fulfillmentType !== 'COURIER'}}" class="delivery-editor"><input value="{{item.delivery.runnerName}}" placeholder="跑腿称呼（可选）" data-id="{{item.id}}" data-field="runnerName" bindinput="onRunnerInput" /><input value="{{item.delivery.runnerPhone}}" type="number" maxlength="11" placeholder="联系电话（可选）" data-id="{{item.id}}" data-field="runnerPhone" bindinput="onRunnerInput" /></view><view wx:if="{{item.customerRemark || item.addressSnapshot.remark}}" class="merchant-order-items">备注：{{item.customerRemark}} {{item.addressSnapshot.remark}}</view><view wx:if="{{item.paymentReviewRequired}}" class="merchant-order-items merchant-alert">退款需关注：请查退款结果；异常单请在微信商户后台核查</view><view class="merchant-order-foot"><view class="merchant-order-amount">实付 <text>¥{{item.payableText}}</text></view><view class="merchant-order-actions"><button wx:if="{{item.fulfillmentType === 'COURIER' && item.status === 'PAID'}}" class="primary-button primary-button--small" data-id="{{item.id}}" bindtap="shipOrder">填写单号发货</button><button wx:if="{{item.fulfillmentType === 'COURIER' && item.status === 'SHIPPED'}}" class="primary-button primary-button--small" data-id="{{item.id}}" bindtap="completeOrder">标记完成</button><button wx:if="{{item.fulfillmentType !== 'COURIER' && item.status === 'PAID'}}" class="primary-button primary-button--small" data-id="{{item.id}}" bindtap="startPreparing">开始制作</button><button wx:if="{{item.fulfillmentType !== 'COURIER' && item.status === 'PREPARING'}}" class="primary-button primary-button--small" data-id="{{item.id}}" bindtap="startDelivery">已叫跑腿</button><button wx:if="{{item.fulfillmentType !== 'COURIER' && item.status === 'DELIVERING'}}" class="outline-button merchant-small-button" data-id="{{item.id}}" bindtap="completeOrder">完成订单</button><button wx:if="{{canRefund && (item.status === 'PAID' || item.status === 'PREPARING' || item.status === 'DELIVERING' || item.status === 'SHIPPED' || item.status === 'COMPLETED')}}" class="outline-button merchant-small-button" data-id="{{item.id}}" bindtap="refundOrder">退款</button><button wx:if="{{canRefund && (item.status === 'REFUNDING' || item.status === 'REFUND_FAILED' || item.status === 'REFUND_REVIEW')}}" class="outline-button merchant-small-button" data-id="{{item.id}}" bindtap="queryRefund">查退款</button><button wx:if="{{canRefund && item.status === 'REFUND_FAILED'}}" class="outline-button merchant-small-button" data-id="{{item.id}}" bindtap="newRefundAttempt">重新发起退款</button></view></view></view></view><view wx:else class="merchant-empty"><view><image class="ui-icon ui-icon--large" src="/images/theme/receipt.svg" /></view><text>这个状态下暂时没有订单</text></view>
</view>
