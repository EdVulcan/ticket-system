<view class="page-shell merchant-stats-page">
  <view wx:if="{{unavailable}}" class="save-tip">数据统计接口暂未接入，生产环境不会展示本地演示数据。</view>
  <view class="stats-heading"><view><view class="section-title">数据统计</view><view class="muted-text">订单、销售额和助力记录概览</view></view><view class="refresh-link" bindtap="refresh">刷新</view></view>
  <view class="stats-grid stats-grid--primary"><view class="metric-card metric-card--green"><view class="metric-label">累计销售额</view><view class="metric-value">¥{{stats.salesText}}</view><view class="metric-foot">已支付及退款处理中订单</view></view><view class="metric-card metric-card--red"><view class="metric-label">订单总数</view><view class="metric-value">{{stats.orderCount}}</view><view class="metric-foot">含待付款和已取消</view></view></view>
  <view class="stats-grid stats-grid--secondary"><view class="metric-card"><view class="metric-label">校园外卖</view><view class="metric-value metric-value--small">{{stats.takeawayOrders}}</view><view class="metric-foot">人工跑腿履约</view></view><view class="metric-card"><view class="metric-label">冷吃快递</view><view class="metric-value metric-value--small">{{stats.courierOrders}}</view><view class="metric-foot">成都发货订单</view></view></view>
  <view class="stats-section"><view class="stats-section-head"><view class="detail-card-title">近 7 日趋势</view><view class="muted-text">销售额 / 订单数</view></view><view class="daily-list"><view wx:for="{{stats.daily}}" wx:key="date" class="daily-row"><view class="daily-date">{{item.dateText}}</view><view class="daily-bar-track"><view class="daily-bar" style="width: {{item.barWidth}}%;"></view></view><view class="daily-sales">¥{{item.salesText}}</view><view class="daily-orders">{{item.orderCount}} 单</view></view></view></view>
  <view class="stats-section stats-section--assist"><view class="stats-section-head"><view class="detail-card-title">分享助力</view><view class="muted-text">成功记录的双人发券次数</view></view><view class="assist-metrics"><view><view class="assist-number">{{stats.assistCount}}</view><view class="assist-label">成功助力</view></view><view><view class="assist-number">{{stats.couponCount}}</view><view class="assist-label">已发优惠券</view></view></view></view>
  <view class="stats-note">{{production ? '数据来自云端最近 2000 条订单和助力记录' : '当前为演示模式，数据来自本机演示订单'}}</view>
</view>
