<view class="page-shell merchant-products-page">
  <view wx:if="{{unavailable}}" class="save-tip">商品管理接口暂未接入，生产环境已禁用上下架、库存和商品写入。</view>
  <view class="products-heading"><view class="section-title">商品管理</view><view class="muted-text">支持上下架、售罄、库存和履约类型调整</view></view>
  <button class="primary-button" bindtap="createProduct" disabled="{{unavailable}}">新增商品</button>
  <view class="product-manage-list"><view wx:for="{{products}}" wx:key="id" class="manage-product card"><view class="manage-product-top"><view class="food-emoji manage-emoji" style="background: {{item.color}};"><image wx:if="{{item.imageFileIds.length}}" class="food-photo" mode="aspectFill" src="{{item.imageFileIds[0]}}" /><image wx:else class="ui-icon ui-icon--large" src="/images/theme/bowl.svg" /></view><view class="manage-product-copy"><view class="manage-product-title">{{item.name || '未命名商品'}} <text wx:if="{{item.tag}}" class="tag">{{item.tag}}</text></view><view class="manage-product-kind">{{item.fulfillmentType === 'COURIER' ? '冷吃快递 · 成都发货' : '校园外卖 · 人工跑腿'}}</view><view class="manage-product-price">¥{{item.priceText || '0.00'}} <text>{{item.soldText || '销量待同步'}}</text></view></view><switch checked="{{item.isOnSale}}" disabled="{{unavailable}}" color="#27654b" data-id="{{item.id}}" bindchange="toggleSale" /></view><view wx:if="{{item.description}}" class="manage-product-description">{{item.description}}</view><view class="manage-product-actions"><view class="edit-product-action" data-id="{{item.id}}" bindtap="editProduct">编辑内容 / 价格</view></view><view class="stock-row"><view class="stock-status {{item.isOnSale ? 'stock-status--on' : 'stock-status--off'}}">{{item.isOnSale ? '在售' : '已下架'}}</view><view class="stock-control"><text>库存</text><view class="stock-button" data-id="{{item.id}}" data-delta="-1" bindtap="changeStock">−</view><view class="stock-number">{{item.stockMode === 'UNLIMITED' ? '∞' : item.stock}}</view><view class="stock-button" data-id="{{item.id}}" data-delta="1" bindtap="changeStock">+</view></view><view class="soldout-action" data-id="{{item.id}}" bindtap="toggleSoldOut">{{item.stock > 0 ? (item.isSoldOut ? '解除售罄' : '一键售罄') : '恢复库存'}}</view></view></view></view>
</view>
