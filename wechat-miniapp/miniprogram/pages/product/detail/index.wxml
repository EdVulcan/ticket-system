<view class="page-shell product-detail-page">
  <view class="product-overview">
    <view class="detail-visual" style="background: {{product.color}};">
      <image wx:if="{{product.coverImageUrl}}" class="food-photo" mode="aspectFill" src="{{product.coverImageUrl}}" /><view wx:else class="detail-placeholder"><image class="detail-placeholder-icon" src="/images/theme/rabbit-pair.svg" /><view>{{storeName || brand.name}}</view></view>
    </view>

    <view class="detail-intro">
      <view class="detail-title-row"><view class="detail-title">{{product.name || '未命名商品'}}</view><view wx:if="{{product.tag}}" class="tag">{{product.tag}}</view></view>
      <view wx:if="{{product.description}}" class="detail-description">{{product.description}}</view>
      <view wx:if="{{product.id && product.stockMode === 'UNLIMITED'}}" class="detail-sold">不限库存</view>
      <view wx:elif="{{product.id && product.stockKnown}}" class="detail-sold">剩余库存：{{product.stock}}</view>
      <view wx:elif="{{product.id}}" class="detail-sold">库存待同步</view>
      <view class="detail-price-row"><text class="price">{{priceText}}</text><text wx:if="{{product.originalPrice > product.price}}" class="old-price">{{originalPriceText}}</text></view>
    </view>

    <view class="fulfillment-note card"><image class="ui-icon" src="{{fulfillmentType === 'COURIER' ? '/images/theme/truck.svg' : '/images/theme/pin.svg'}}" /><view><view>{{fulfillmentType === 'COURIER' ? '快递寄送' : '配送 / 到店自取'}}</view><text>{{deliveryText || '费用以结算页为准'}}</text></view></view>
  </view>

  <view class="purchase-options">
    <view wx:if="{{skuChoices.length}}" class="option-card"><view class="option-group"><view class="option-title">规格 <text>必选</text></view><view class="option-values"><view wx:for="{{skuChoices}}" wx:key="id" class="option-value {{selectedSkuId === item.id ? 'option-value--selected' : ''}}" data-id="{{item.id}}" bindtap="selectSku">{{item.name}} · ¥{{item.price / 100}}</view></view></view></view>

    <view wx:if="{{product.options.length}}" class="option-card">
      <view wx:for="{{product.options}}" wx:for-item="group" wx:key="id" class="option-group">
        <view class="option-title">{{group.name || '可选项'}} <text wx:if="{{group.required}}">必选</text></view>
        <view class="option-values">
          <view wx:for="{{group.values}}" wx:for-item="option" wx:key="*this" class="option-value {{selectedValues[group.id] === option ? 'option-value--selected' : ''}}" data-group="{{group.id}}" data-value="{{option}}" bindtap="selectOption">{{option}}</view>
        </view>
      </view>
    </view>

    <view class="detail-note">
      <view class="option-title">备注 <text>可选</text></view>
      <input value="{{remark}}" maxlength="60" placeholder="口味、餐具等特殊要求" bindinput="onRemarkInput" />
    </view>
  </view>

  <view wx:if="{{product.detailImageUrls && product.detailImageUrls.length}}" class="detail-media-section">
    <view class="detail-media-heading"><view class="detail-media-title">商品详情</view><view class="detail-media-line"></view></view>
    <view class="detail-gallery"><image wx:for="{{product.detailImageUrls}}" wx:key="*this" class="detail-gallery-image" mode="widthFix" src="{{item}}" lazy-load="{{true}}" /></view>
  </view>

  <view class="bottom-action">
    <view class="purchase-summary">
      <text class="purchase-summary-label">商品合计</text>
      <text class="purchase-total">¥{{totalPriceText}}</text>
    </view>
    <view class="purchase-actions">
      <view class="quantity-control" aria-label="购买数量">
        <view class="quantity-button {{quantity <= 1 ? 'quantity-button--disabled' : ''}}" bindtap="decrease" role="button" aria-label="减少数量">−</view>
        <view class="quantity-number">{{quantity}}</view>
        <view class="quantity-button" bindtap="increase" role="button" aria-label="增加数量">+</view>
      </view>
      <button class="outline-button add-detail-button" bindtap="addToCart" disabled="{{buying || unavailable || product.isSoldOut || (product.stockMode !== 'UNLIMITED' && product.stock <= 0)}}">加入购物车</button>
      <button class="primary-button buy-detail-button" bindtap="buyNow" loading="{{buying}}" disabled="{{buying || unavailable || product.isSoldOut || (product.stockMode !== 'UNLIMITED' && product.stock <= 0)}}">立即购买</button>
    </view>
  </view>
</view>
