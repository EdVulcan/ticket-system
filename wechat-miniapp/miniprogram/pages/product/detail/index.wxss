@import "../../../styles/common.wxss";

.product-detail-page { padding: 28rpx 30rpx 220rpx; }
.product-overview, .purchase-options { background: var(--surface); border: 1rpx solid #efefe8; border-radius: 24rpx; overflow: hidden; }
.detail-visual { align-items: center; display: flex; height: 360rpx; justify-content: center; overflow: hidden; position: relative; }
.detail-placeholder { display: flex; flex-direction: column; justify-content: center; align-items: center; width: 100%; height: 100%; background: #eeeee3; color: #657560; font-size: 24rpx; letter-spacing: 2rpx; padding-bottom: 24rpx; gap: 18rpx; }
.detail-placeholder-icon { width: 188rpx; height: 160rpx; }
.detail-intro { padding: 28rpx; }
.detail-title-row { align-items: center; display: flex; gap: 12rpx; }
.detail-title { color: var(--ink); flex: 1; font-size: 38rpx; font-weight: 700; line-height: 1.4; min-width: 0; overflow-wrap: anywhere; }
.detail-description { color: var(--muted); font-size: 25rpx; line-height: 1.6; margin-top: 12rpx; overflow-wrap: anywhere; }
.detail-sold { color: var(--muted); font-size: 22rpx; margin-top: 12rpx; }
.detail-price-row { margin-top: 18rpx; }
.detail-price-row .price { font-size: 42rpx; }
.fulfillment-note { align-items: center; background: transparent; border: 0; border-top: 1rpx solid var(--line); border-radius: 0; display: flex; gap: 16rpx; margin: 0 28rpx; padding: 22rpx 0; }
.fulfillment-note > view { min-width: 0; }
.fulfillment-note view view { color: var(--ink); font-size: 25rpx; font-weight: 600; }
.fulfillment-note text { color: var(--muted); display: block; font-size: 21rpx; margin-top: 5rpx; overflow-wrap: anywhere; }
.purchase-options { margin-top: 24rpx; padding: 0 28rpx; }
.option-card, .detail-note { padding: 26rpx 0; }
.option-card + .option-card, .option-card + .detail-note { border-top: 1rpx solid var(--line); }
.option-group + .option-group { border-top: 1rpx solid var(--line); margin-top: 24rpx; padding-top: 24rpx; }
.option-title { color: var(--ink); font-size: 27rpx; font-weight: 600; }
.option-title text { color: var(--muted); font-size: 21rpx; font-weight: 400; margin-left: 8rpx; }
.option-values { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.option-value { background: var(--paper); border: 1rpx solid var(--line); border-radius: 12rpx; color: var(--muted); font-size: 25rpx; padding: 16rpx 22rpx; max-width: 100%; overflow-wrap: anywhere; }
.option-value--selected { background: var(--green-soft); border-color: var(--green); color: var(--green); font-weight: 600; }
.detail-note input { color: var(--ink); font-size: 25rpx; height: 64rpx; margin-top: 12rpx; }
.detail-media-section { margin-top: 28rpx; }
.detail-media-heading { align-items: center; display: flex; gap: 18rpx; margin-bottom: 20rpx; }
.detail-media-title { color: var(--ink); flex-shrink: 0; font-size: 29rpx; font-weight: 600; }
.detail-media-line { background: var(--line); height: 1rpx; width: 100%; }
.detail-gallery { background: var(--surface); border-radius: 24rpx; overflow: hidden; }
.detail-gallery-image { background: #f0f1eb; display: block; min-height: 240rpx; width: 100%; }
.detail-gallery-image + .detail-gallery-image { border-top: 2rpx solid var(--line); }
.bottom-action { align-items: center; background: rgba(251,250,246,.98); border-top: 1rpx solid var(--line); bottom: 0; display: flex; left: 0; padding: 24rpx 30rpx calc(24rpx + env(safe-area-inset-bottom)); position: fixed; right: 0; z-index: 30; }
.quantity-control { align-items: center; display: flex; margin-right: 20rpx; }
.quantity-button { align-items: center; background: var(--paper); border-radius: 12rpx; color: var(--ink); display: flex; font-size: 34rpx; height: 64rpx; justify-content: center; width: 64rpx; }
.quantity-button--plus { background: var(--green-soft); color: var(--green); }
.quantity-number { color: var(--ink); font-size: 28rpx; font-weight: 600; min-width: 48rpx; text-align: center; }
.add-detail-button { flex: 1; font-size: 26rpx; min-height: 88rpx; line-height: 88rpx; padding: 0 12rpx; }

@media (max-width: 360px) {
  .product-detail-page { padding-bottom: 270rpx; }
  .bottom-action { align-items: stretch; flex-wrap: wrap; gap: 14rpx; }
  .quantity-control { justify-content: center; margin-right: 0; width: 100%; }
  .add-detail-button { width: 100%; }
}
