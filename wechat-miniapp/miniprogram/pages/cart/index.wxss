@import "../../styles/common.wxss";

.cart-page { padding: 28rpx 30rpx 48rpx; }
.cart-header { margin-bottom: 24rpx; }
.cart-header .section-title { margin-bottom: 8rpx; }
.clear-cart { color: var(--muted); font-size: 23rpx; padding: 16rpx 0 16rpx 16rpx; }
.cart-content-panel { background: var(--surface); border: 1rpx solid #efefe8; border-radius: 24rpx; padding: 0 28rpx; }
.cart-group { padding: 24rpx 0 8rpx; }
.cart-group + .cart-group { border-top: 1rpx solid var(--line); }
.cart-group-head { align-items: center; display: flex; gap: 14rpx; }
.cart-group-icon { align-items: center; background: var(--green-soft); border-radius: 16rpx; display: flex; flex-shrink: 0; height: 56rpx; justify-content: center; width: 56rpx; }
.cart-group-copy { flex: 1; min-width: 0; }
.cart-group-title { color: var(--ink); font-size: 28rpx; font-weight: 600; }
.cart-group-subtitle { color: var(--muted); font-size: 22rpx; line-height: 1.45; margin-top: 3rpx; overflow-wrap: anywhere; }
.cart-group-total { color: var(--red); flex-shrink: 0; font-size: 26rpx; margin-left: auto; }
.cart-list { padding: 0; }
.cart-item { align-items: center; border-bottom: 1rpx solid var(--line); display: flex; padding: 24rpx 0; }
.cart-item:last-child { border-bottom: 0; }
.cart-emoji { flex-shrink: 0; font-size: 52rpx; height: 120rpx; width: 120rpx; }
.cart-item-main { flex: 1; min-width: 0; margin-left: 20rpx; }
.cart-item-title { color: var(--ink); font-size: 29rpx; font-weight: 600; overflow-wrap: anywhere; }
.cart-options { color: var(--muted); font-size: 22rpx; margin-top: 8rpx; overflow-wrap: anywhere; }
.cart-item-bottom { align-items: center; display: flex; flex-wrap: wrap; gap: 12rpx; justify-content: space-between; margin-top: 18rpx; }
.cart-item-bottom .price { font-size: 30rpx; }
.quantity-control { align-items: center; display: flex; flex-shrink: 0; }
.quantity-button { align-items: center; background: var(--paper); border-radius: 10rpx; color: var(--ink); display: flex; font-size: 30rpx; height: 60rpx; justify-content: center; width: 60rpx; }
.quantity-button--plus { color: var(--green); }
.quantity-number { color: var(--ink); font-size: 25rpx; min-width: 48rpx; text-align: center; }
.cart-group-foot { color: var(--muted); display: flex; font-size: 22rpx; justify-content: space-between; padding: 0 0 22rpx; }
.cart-group-foot text { color: var(--ink); }
.cart-note { align-items: flex-start; border-top: 1rpx solid var(--line); color: var(--muted); display: flex; font-size: 22rpx; gap: 10rpx; line-height: 1.6; padding: 22rpx 0 0; }
.cart-note .ui-icon { margin-top: 4rpx; }
.price-summary { border-top: 1rpx solid var(--line); margin-top: 20rpx; padding: 22rpx 0 24rpx; }
.summary-row { color: var(--muted); display: flex; font-size: 26rpx; gap: 16rpx; justify-content: space-between; margin-bottom: 18rpx; }
.summary-total { border-top: 1rpx solid var(--line); color: var(--ink); font-size: 29rpx; font-weight: 600; margin-top: 22rpx; padding-top: 20rpx; }
.summary-total text:last-child { color: var(--green); }
.summary-note { color: var(--muted); font-size: 22rpx; }
.checkout-bar { align-items: center; background: rgba(251,250,246,.98); border-top: 1rpx solid var(--line); bottom: 0; display: flex; gap: 18rpx; justify-content: space-between; left: 0; padding: 22rpx 30rpx calc(22rpx + env(safe-area-inset-bottom)); position: fixed; right: 0; z-index: 20; }
.checkout-bar > view { flex: 1; min-width: 0; }
.checkout-total-label { color: var(--ink); font-size: 24rpx; line-height: 1.35; overflow-wrap: anywhere; }
.checkout-total-label text { color: var(--green); font-size: 38rpx; font-weight: 700; margin-left: 7rpx; }
.checkout-tip { color: var(--muted); font-size: 21rpx; line-height: 1.35; margin-top: 5rpx; overflow-wrap: anywhere; }
.checkout-button { flex-shrink: 0; font-size: 27rpx; height: 76rpx; line-height: 76rpx; min-width: 220rpx; }
.empty-title { color: var(--ink); font-size: 31rpx; font-weight: 600; }
.empty-desc { color: var(--muted); font-size: 24rpx; margin-top: 10rpx; }
.empty-button { margin-top: 36rpx; width: 280rpx; }
