<view class="page-shell order-detail-page" wx:if="{{order}}">
  <view class="order-progress-panel">
    <view class="detail-status"><view class="detail-status-icon">{{statusIcon}}</view><view class="detail-status-copy"><view class="detail-status-kicker">{{fulfillmentTitle}}</view><view class="detail-status-title">{{order.statusText}}</view><view wx:if="{{refundMessage || statusDescription}}" class="detail-status-desc {{order.status === 'REFUND_FAILED' || order.status === 'REFUND_REVIEW' ? 'detail-status-desc--refund' : ''}}">{{refundMessage || statusDescription}}</view></view></view>

    <view wx:if="{{order.fulfillmentClosed}}" class="timeline"><view class="detail-card-title">订单进度</view><view class="timeline-item timeline-item--active"><view class="timeline-dot"></view><view><view>订单已提交</view><text>{{order.createdText}}</text></view></view><view class="timeline-line timeline-line--active"></view><view class="timeline-item timeline-item--active"><view class="timeline-dot"></view><view><view>订单已关闭</view></view></view></view>
    <view wx:elif="{{isCourier}}" class="timeline">
      <view class="detail-card-title">订单进度</view>
      <view class="timeline-item timeline-item--active"><view class="timeline-dot"></view><view><view>订单已提交</view><text>{{order.createdText}}</text></view></view>
      <view class="timeline-line {{order.retailDispatched ? 'timeline-line--active' : ''}}"></view>
      <view class="timeline-item {{order.retailDispatched ? 'timeline-item--active' : ''}}"><view class="timeline-dot"></view><view><view>{{order.retailDispatched ? '商家已发货' : '等待发货'}}</view><text>{{order.retailDispatched ? order.shippedText : order.status === 'WAIT_PAY' ? '付款后由商家安排发货' : order.status === 'CANCELED' || order.status === 'REFUNDED' ? '订单已关闭' : '由商家安排发货'}}</text></view></view>
      <view class="timeline-line {{order.fulfillmentCompleted ? 'timeline-line--active' : ''}}"></view>
      <view class="timeline-item {{order.fulfillmentCompleted ? 'timeline-item--active' : ''}}"><view class="timeline-dot"></view><view><view>{{order.fulfillmentCompleted ? '已确认收货' : '确认收货'}}</view><text>{{order.fulfillmentCompleted ? order.completedText : '收到商品后请确认收货'}}</text></view></view>
    </view>
    <view wx:else class="timeline"><view class="timeline-item timeline-item--active"><view class="timeline-dot"></view><view><view>订单已提交</view><text>{{order.createdText}}</text></view></view><view class="timeline-line {{order.timelineStatus === 'ACCEPTED' || order.timelineStatus === 'PREPARING' || order.timelineStatus === 'READY' || order.timelineStatus === 'DELIVERING' || order.timelineStatus === 'COMPLETED' ? 'timeline-line--active' : ''}}"></view><view class="timeline-item {{order.timelineStatus === 'ACCEPTED' || order.timelineStatus === 'PREPARING' || order.timelineStatus === 'READY' || order.timelineStatus === 'DELIVERING' || order.timelineStatus === 'COMPLETED' ? 'timeline-item--active' : ''}}"><view class="timeline-dot"></view><view><view>门店接单制作</view><text>{{order.preparingText || (order.timelineStatus === 'PAID' || order.timelineStatus === 'WAIT_PAY' ? '等待门店接单' : order.timelineStatus === 'ACCEPTED' ? '商家已接单，等待开始制作' : '门店已接单制作')}}</text></view></view><view class="timeline-line {{order.timelineStatus === 'READY' || order.timelineStatus === 'DELIVERING' || order.timelineStatus === 'COMPLETED' ? 'timeline-line--active' : ''}}"></view><view class="timeline-item {{order.timelineStatus === 'READY' || order.timelineStatus === 'DELIVERING' || order.timelineStatus === 'COMPLETED' ? 'timeline-item--active' : ''}}"><view class="timeline-dot"></view><view><view>{{order.timelineStatus === 'READY' ? (order.deliveryMethod === 'PICKUP' ? '餐食已备好 · 待取餐' : '餐食已备好 · 待配送') : order.deliveryMethod === 'PICKUP' ? '门店自取' : '餐饮配送'}}</view><text>{{order.timelineStatus === 'READY' ? order.readyText || (order.deliveryMethod === 'PICKUP' ? '餐食已备好，请到店取餐' : '餐食已备好，等待配送出发') : order.deliveringText || (order.deliveryMethod === 'PICKUP' ? '门店备餐完成后到店取餐' : '等待出餐并安排配送')}}</text></view></view><view class="timeline-line {{order.timelineStatus === 'COMPLETED' ? 'timeline-line--active' : ''}}"></view><view class="timeline-item {{order.timelineStatus === 'COMPLETED' ? 'timeline-item--active' : ''}}"><view class="timeline-dot"></view><view><view>已完成</view><text>{{order.completedText || '完成后可查看订单'}}</text></view></view></view>

    <view wx:if="{{!isCourier && order.deliveryMethod !== 'PICKUP' && order.delivery && order.delivery.showDeliveryInfo}}" class="runner-card runner-card--detail"><view class="runner-icon"><image class="ui-icon" src="/images/theme/truck.svg" /></view><view class="runner-copy"><view class="runner-title">{{order.delivery.deliveryCardTitle}}</view><view wx:if="{{order.delivery.deliveryProviderText}}" class="runner-text">方式：{{order.delivery.deliveryProviderText}}</view><view wx:if="{{order.delivery.courierPlatformName}}" class="runner-text">平台：{{order.delivery.courierPlatformName}}</view><view wx:if="{{order.delivery.courierOrderNo}}" class="runner-text">单号：{{order.delivery.courierOrderNo}}</view><view wx:if="{{order.delivery.contactPhone}}" class="runner-text">联系方式：{{order.delivery.contactPhone}}</view><view wx:if="{{order.delivery.deliveryNote}}" class="runner-text">备注：{{order.delivery.deliveryNote}}</view></view><view wx:if="{{order.delivery.contactPhone}}" class="runner-call" bindtap="callRunner">拨打</view></view>
    <view wx:if="{{isCourier && order.shipping && order.shipping.trackingNo}}" class="runner-card"><view class="runner-icon runner-icon--red"><image class="ui-icon" src="/images/theme/truck.svg" /></view><view class="runner-copy"><view class="runner-title">{{order.shipping.carrier || '快递信息'}}</view><view class="tracking-number-row"><text class="runner-text tracking-number" selectable="{{true}}">{{order.shipping.trackingNo}}</text><button class="tracking-copy" bindtap="copyTrackingNo" aria-label="复制快递单号" hover-class="tracking-copy--pressed">复制</button></view></view></view>

  </view>

  <view class="order-info-panel">
    <view class="order-detail-card"><view class="detail-card-title">商品明细</view><view wx:for="{{order.itemsSnapshot}}" wx:key="lineId" class="detail-line"><view class="detail-line-visual" style="background: {{item.color}};"><image wx:if="{{item.coverImageUrl}}" class="detail-line-photo" mode="aspectFill" src="{{item.coverImageUrl}}" lazy-load="{{true}}" /><image wx:else class="ui-icon" src="{{isCourier ? '/images/theme/snack.svg' : '/images/theme/bowl.svg'}}" /></view><view class="detail-line-name"><text>{{item.name}}</text><text wx:if="{{item.optionsText}}" class="detail-line-options">{{item.optionsText}}</text></view><text class="detail-line-quantity">×{{item.quantity}}</text><text class="detail-line-price">¥{{item.subtotalText}}</text></view><view class="divider"></view><view class="amount-line"><text>商品小计</text><text>¥{{goodsAmountText}}</text></view><view wx:if="{{!isCourier && order.deliveryMethod !== 'PICKUP'}}" class="amount-line"><text>配送费</text><text>¥{{deliveryFeeText}}</text></view><view wx:if="{{!isCourier && order.deliveryMethod === 'PICKUP'}}" class="amount-line"><text>取餐方式</text><text>门店自取</text></view><view wx:if="{{isCourier}}" class="amount-line"><text>快递费</text><text>¥{{shippingFeeText}}</text></view><view class="amount-line"><text>优惠券</text><text class="discount-text">-¥{{discountText}}</text></view><view class="amount-line amount-line--total"><text>实付</text><text>¥{{payableText}}</text></view></view>

    <view class="address-detail-card"><view class="detail-card-title">{{isCourier ? '收货信息' : order.deliveryMethod === 'PICKUP' ? '自取信息' : '配送信息'}}</view><view wx:if="{{isCourier || order.deliveryMethod !== 'PICKUP'}}" class="address-line"><text class="address-line-label">收货人</text><text>{{order.addressSnapshot.contactName}} {{order.addressSnapshot.contactPhone}}</text></view><view wx:if="{{isCourier || order.deliveryMethod !== 'PICKUP'}}" class="address-line"><text class="address-line-label">送达至</text><text>{{order.addressText}}</text></view><view wx:if="{{!isCourier && order.deliveryMethod === 'PICKUP'}}" class="address-line"><text class="address-line-label">取餐方式</text><text>到店自取 · 请联系门店确认取餐</text></view><view wx:if="{{order.customerRemark}}" class="address-line"><text class="address-line-label">备注</text><text>{{order.customerRemark}}</text></view></view>

    <view class="order-no">订单编号：{{order.orderNo}}</view>
  </view>
  <view class="order-tools"><button wx:if="{{order.paymentClosing}}" class="outline-button" bindtap="contactStore">联系门店核实</button><button class="outline-button" bindtap="refreshOrder">刷新订单 / 核实状态</button></view>
  <view class="bottom-space"></view><view class="detail-actions"><button wx:if="{{canRequestRefund}}" class="outline-button" bindtap="refundOrder" disabled="{{refundSubmitting || actionSubmitting}}">{{refundSubmitting ? '申请中…' : order.fulfillmentCompleted ? '申请售后' : '申请退款'}}</button><button wx:if="{{order.status === 'AFTER_SALE_REVIEW' || order.status === 'REFUNDING' || order.status === 'REFUND_FAILED' || order.status === 'REFUND_REVIEW'}}" class="outline-button" bindtap="queryRefund" disabled="{{refundQuerying}}">{{refundQuerying ? '查询中…' : order.status === 'AFTER_SALE_REVIEW' ? '刷新售后状态' : '查询退款状态'}}</button><button wx:if="{{order.status === 'WAIT_PAY' && !order.paymentClosing}}" class="primary-button action-main" bindtap="payOrder" disabled="{{paying || actionSubmitting}}">{{paying ? '支付中…' : '继续支付'}}</button><button wx:if="{{canCancelOrder}}" class="outline-button" bindtap="cancelOrder" disabled="{{actionSubmitting}}">取消订单</button><button wx:if="{{canConfirmReceipt}}" class="primary-button action-main" bindtap="confirmReceipt" disabled="{{actionSubmitting}}">确认收货</button><button wx:if="{{order.fulfillmentCompleted || order.status === 'CANCELED'}}" class="primary-button action-main" bindtap="reorder">再来一单</button><button wx:if="{{order.status !== 'WAIT_PAY' && order.status !== 'DELIVERING' && order.status !== 'SHIPPED' && order.status !== 'COMPLETED' && order.status !== 'CANCELED' && order.status !== 'AFTER_SALE_REVIEW' && order.status !== 'REFUNDING' && order.status !== 'REFUND_FAILED' && order.status !== 'REFUND_REVIEW'}}" class="outline-button" bindtap="contactStore">联系门店</button></view>
</view>
