<view class="page-shell order-detail-page" wx:if="{{order}}">
  <view class="detail-status card"><view class="detail-status-icon">{{statusIcon}}</view><view class="detail-status-copy"><view class="detail-status-kicker">{{fulfillmentTitle}}</view><view class="detail-status-title">{{order.statusText}}</view><view class="detail-status-desc">{{statusDescription}}</view><view wx:if="{{refundMessage}}" class="detail-status-desc detail-status-desc--refund">{{refundMessage}}</view></view></view>

  <view wx:if="{{isCourier && shipmentEvents.length}}" class="shipment-timeline card"><view class="detail-card-title">物流动态</view><view wx:for="{{shipmentEvents}}" wx:key="id" class="shipment-event {{index === shipmentEvents.length - 1 ? 'shipment-event--latest' : ''}}"><view class="timeline-dot"></view><view class="shipment-event-copy"><view>{{item.description}}</view><text>{{item.occurredText}}{{item.locationText}}</text></view></view></view>
  <view wx:elif="{{isCourier}}" class="timeline card"><view class="timeline-item timeline-item--active"><view class="timeline-dot"></view><view><view>订单已提交</view><text>{{order.createdText}}</text></view></view><view class="timeline-line {{order.status === 'PAID' || order.status === 'SHIPPED' || order.status === 'COMPLETED' ? 'timeline-line--active' : ''}}"></view><view class="timeline-item {{order.status === 'PAID' || order.status === 'SHIPPED' || order.status === 'COMPLETED' ? 'timeline-item--active' : ''}}"><view class="timeline-dot"></view><view><view>等待发货</view><text>{{order.status === 'PAID' ? '已付款，等待打包' : order.shippedText || '等待付款'}}</text></view></view><view class="timeline-line {{order.status === 'SHIPPED' || order.status === 'COMPLETED' ? 'timeline-line--active' : ''}}"></view><view class="timeline-item {{order.status === 'SHIPPED' || order.status === 'COMPLETED' ? 'timeline-item--active' : ''}}"><view class="timeline-dot"></view><view><view>运输中</view><text>{{order.shipping && order.shipping.carrier ? order.shipping.carrier + ' · ' + order.shipping.trackingNo : '等待发货信息'}}</text></view></view><view class="timeline-line {{order.status === 'COMPLETED' ? 'timeline-line--active' : ''}}"></view><view class="timeline-item {{order.status === 'COMPLETED' ? 'timeline-item--active' : ''}}"><view class="timeline-dot"></view><view><view>已签收</view><text>{{order.completedText || '收到包裹后可确认收货'}}</text></view></view></view>
  <view wx:else class="timeline card"><view class="timeline-item timeline-item--active"><view class="timeline-dot"></view><view><view>订单已提交</view><text>{{order.createdText}}</text></view></view><view class="timeline-line {{order.status === 'PAID' || order.status === 'PREPARING' || order.status === 'DELIVERING' || order.status === 'COMPLETED' ? 'timeline-line--active' : ''}}"></view><view class="timeline-item {{order.status === 'PAID' || order.status === 'PREPARING' || order.status === 'DELIVERING' || order.status === 'COMPLETED' ? 'timeline-item--active' : ''}}"><view class="timeline-dot"></view><view><view>门店接单制作</view><text>{{order.preparingText || '等待门店接单'}}</text></view></view><view class="timeline-line {{order.status === 'DELIVERING' || order.status === 'COMPLETED' ? 'timeline-line--active' : ''}}"></view><view class="timeline-item {{order.status === 'DELIVERING' || order.status === 'COMPLETED' ? 'timeline-item--active' : ''}}"><view class="timeline-dot"></view><view><view>{{order.deliveryMethod === 'PICKUP' ? '门店自取' : '餐饮配送'}}</view><text>{{order.deliveringText || (order.deliveryMethod === 'PICKUP' ? '门店备餐完成后到店取餐' : '等待出餐并安排配送')}}</text></view></view><view class="timeline-line {{order.status === 'COMPLETED' ? 'timeline-line--active' : ''}}"></view><view class="timeline-item {{order.status === 'COMPLETED' ? 'timeline-item--active' : ''}}"><view class="timeline-dot"></view><view><view>已完成</view><text>{{order.completedText || '完成后可查看订单'}}</text></view></view></view>

  <view wx:if="{{!isCourier && order.delivery && order.delivery.status === 'CALLED'}}" class="runner-card card"><view class="runner-icon"><image class="ui-icon" src="/images/theme/truck.svg" /></view><view class="runner-copy"><view class="runner-title">配送中</view><view class="runner-text">{{order.delivery.runnerName}} · {{order.delivery.runnerPhone}}</view></view><view class="runner-call" bindtap="callRunner">拨打</view></view>
  <view wx:if="{{isCourier && order.shipping && order.shipping.status === 'SHIPPED'}}" class="runner-card card"><view class="runner-icon runner-icon--red"><image class="ui-icon" src="/images/theme/truck.svg" /></view><view class="runner-copy"><view class="runner-title">包裹运输中</view><view class="runner-text">{{order.shipping.carrier}} · {{order.shipping.trackingNo}}</view></view></view>

  <view class="order-detail-card card"><view class="detail-card-title">商品明细</view><view wx:for="{{order.itemsSnapshot}}" wx:key="lineId" class="detail-line"><view class="detail-line-visual" style="background: {{item.color}};"><image wx:if="{{item.coverImageUrl}}" class="detail-line-photo" mode="aspectFill" src="{{item.coverImageUrl}}" lazy-load="{{true}}" /><image wx:else class="ui-icon" src="{{isCourier ? '/images/theme/snack.svg' : '/images/theme/bowl.svg'}}" /></view><view class="detail-line-name"><text>{{item.name}}</text><text wx:if="{{item.optionsText}}" class="detail-line-options">{{item.optionsText}}</text></view><text class="detail-line-quantity">×{{item.quantity}}</text><text class="detail-line-price">¥{{item.subtotalText}}</text></view><view class="divider"></view><view class="amount-line"><text>商品小计</text><text>¥{{goodsAmountText}}</text></view><view wx:if="{{!isCourier}}" class="amount-line"><text>配送费</text><text>¥{{deliveryFeeText}}</text></view><view wx:if="{{isCourier}}" class="amount-line"><text>快递费</text><text>¥{{shippingFeeText}}</text></view><view class="amount-line"><text>优惠券</text><text class="discount-text">-¥{{discountText}}</text></view><view class="amount-line amount-line--total"><text>实付</text><text>¥{{payableText}}</text></view></view>

  <view class="address-detail-card card"><view class="detail-card-title">{{isCourier ? '收货信息' : order.deliveryMethod === 'PICKUP' ? '自取信息' : '配送信息'}}</view><view wx:if="{{isCourier || order.deliveryMethod !== 'PICKUP'}}" class="address-line"><text class="address-line-label">收货人</text><text>{{order.addressSnapshot.contactName}} {{order.addressSnapshot.contactPhone}}</text></view><view wx:if="{{isCourier || order.deliveryMethod !== 'PICKUP'}}" class="address-line"><text class="address-line-label">送达至</text><text>{{order.addressText}}</text></view><view wx:if="{{!isCourier && order.deliveryMethod === 'PICKUP'}}" class="address-line"><text class="address-line-label">取餐方式</text><text>到店自取 · 请联系门店确认取餐</text></view><view wx:if="{{order.customerRemark}}" class="address-line"><text class="address-line-label">备注</text><text>{{order.customerRemark}}</text></view></view>

  <view class="order-no">订单编号：{{order.orderNo}}</view><button wx:if="{{order.paymentClosing}}" class="outline-button" bindtap="contactStore">联系门店核实</button><button class="outline-button" bindtap="refreshOrder">刷新订单 / 核实状态</button><view class="bottom-space"></view><view class="detail-actions"><button wx:if="{{canRequestRefund}}" class="outline-button" bindtap="refundOrder" disabled="{{refundSubmitting || actionSubmitting}}">{{refundSubmitting ? '申请中…' : '申请退款'}}</button><button wx:if="{{order.status === 'REFUNDING' || order.status === 'REFUND_FAILED' || order.status === 'REFUND_REVIEW'}}" class="outline-button" bindtap="queryRefund" disabled="{{refundQuerying}}">{{refundQuerying ? '查询中…' : '查询退款状态'}}</button><button wx:if="{{order.status === 'WAIT_PAY' && !order.paymentClosing}}" class="primary-button action-main" bindtap="payOrder" disabled="{{paying || actionSubmitting}}">{{paying ? '支付中…' : '继续支付'}}</button><button wx:if="{{canCancelOrder}}" class="outline-button" bindtap="cancelOrder" disabled="{{actionSubmitting}}">取消订单</button><button wx:if="{{canConfirmReceipt}}" class="primary-button action-main" bindtap="confirmReceipt" disabled="{{actionSubmitting}}">确认收货</button><button wx:if="{{order.status === 'COMPLETED' || order.status === 'CANCELED'}}" class="primary-button action-main" bindtap="reorder">再来一单</button><button wx:if="{{order.status !== 'WAIT_PAY' && order.status !== 'DELIVERING' && order.status !== 'SHIPPED' && order.status !== 'COMPLETED' && order.status !== 'CANCELED' && order.status !== 'REFUNDING' && order.status !== 'REFUND_FAILED' && order.status !== 'REFUND_REVIEW'}}" class="outline-button" bindtap="contactStore">联系门店</button></view>
</view>
