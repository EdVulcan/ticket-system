<view class="page-shell profile-page">
  <view class="profile-header"><view class="avatar"><image wx:if="{{profile.avatarUrl}}" class="food-photo" src="{{profile.avatarUrl}}" mode="aspectFill" /><image wx:else class="profile-rabbits" src="/images/theme/rabbit-pair.svg" /></view><view class="profile-copy"><view class="profile-name">{{profile.nickname || '朋友'}}，你好</view><view class="profile-sub">今天的偏爱，也留一份给自己</view></view></view>
  <view class="profile-theme"><view class="brand-seal brand-seal--red">琑</view><view class="profile-brand-copy"><view class="profile-brand-name">{{brand.name}}</view><view class="profile-brand-tagline">{{brand.tagline}}</view></view></view>

  <view class="member-card">
    <view class="member-card-head"><view><view class="member-card-title">{{memberProfile.membershipStatus === 'active' ? '正式会员' : '完善会员认证'}}</view><view class="member-card-sub">{{memberProfile.phoneVerified ? '手机号已验证，可在自营入口统一查看订单' : '验证手机号后，可在自营入口统一查看订单'}}</view></view><view wx:if="{{memberProfile.phoneVerified}}" class="member-card-status">已认证</view></view>
    <view wx:if="{{memberProfile.phoneMasked}}" class="member-phone">{{memberProfile.phoneMasked}}</view>
    <checkbox-group wx:if="{{!memberProfile.phoneVerified}}" bindchange="onMemberConsentChange"><label class="member-consent"><checkbox value="member" checked="{{memberConsentGranted}}" color="#27654B" />我已阅读并同意会员服务说明</label></checkbox-group>
    <button wx:if="{{!memberProfile.phoneVerified}}" class="member-action" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" disabled="{{verifyingMemberPhone || !memberConsentGranted}}">{{verifyingMemberPhone ? '认证中…' : '完成会员认证'}}</button>
    <view wx:if="{{memberError}}" class="member-error">{{memberError}}</view>
  </view>

  <view class="coupon-banner" bindtap="toggleCoupons" role="button" aria-label="我的优惠券，{{couponCount}}张可用">
    <view class="coupon-banner-copy"><view>我的优惠券</view><view>给这一餐，加一点小确幸</view></view>
    <view class="coupon-banner-number">{{couponCount}}<text>张</text></view><image class="ui-icon ui-icon--small" src="/images/theme/arrow-white.svg" />
  </view>
  <view wx:if="{{showCoupons}}" class="coupon-panel card">
    <view wx:for="{{coupons}}" wx:key="id" class="profile-coupon"><view class="profile-coupon-amount">¥{{item.discountAmount / 100}}</view><view class="profile-coupon-copy"><view>{{item.name}}</view><view>{{item.description}}</view><view>有效期至 {{item.expireAt}}</view></view></view>
    <view wx:if="{{!coupons.length}}" class="muted-text coupon-empty">暂无可用优惠券</view>
  </view>

  <view class="quick-orders"><view class="quick-orders-head"><view class="detail-card-title">我的订单</view><view class="section-link" data-tab="ALL" bindtap="goOrders">查看全部<image class="ui-icon ui-icon--small" src="/images/theme/chevron.svg" /></view></view><view class="quick-order-grid">
    <view class="quick-order-item" data-tab="WAIT_PAY" bindtap="goOrders"><image class="quick-order-icon" src="/images/theme/clock.svg" /><view>待付款</view><text wx:if="{{orderStats.waitPay}}">{{orderStats.waitPay}}</text></view>
    <view class="quick-order-item" data-tab="PROCESSING" bindtap="goOrders"><image class="quick-order-icon" src="/images/theme/bowl.svg" /><view>制作中</view><text wx:if="{{orderStats.processing}}">{{orderStats.processing}}</text></view>
    <view class="quick-order-item" data-tab="DELIVERING" bindtap="goOrders"><image class="quick-order-icon" src="/images/theme/truck.svg" /><view>配送中</view><text wx:if="{{orderStats.delivering}}">{{orderStats.delivering}}</text></view>
    <view class="quick-order-item" data-tab="COMPLETED" bindtap="goOrders"><image class="quick-order-icon" src="/images/theme/check.svg" /><view>已完成</view></view>
  </view></view>

  <view class="profile-menu">
    <view class="menu-row" bindtap="goAddress"><image class="menu-icon" src="/images/theme/pin.svg" /><view class="menu-copy"><view>收货地址</view><view>配送区域、详细地址与联系电话</view></view><image class="ui-icon ui-icon--small" src="/images/theme/chevron.svg" /></view>
    <view class="menu-row" bindtap="goAssist"><image class="menu-icon" src="/images/theme/rabbit-pair.svg" /><view class="menu-copy"><view>好友助力</view><view>邀请同好，分享一份优惠</view></view><image class="ui-icon ui-icon--small" src="/images/theme/chevron.svg" /></view>
    <view wx:if="{{contact.available}}" class="menu-row" bindtap="openContact"><image class="menu-icon" src="/images/icons/customer-service.svg" /><view class="menu-copy"><view>联系商家</view><view>{{contact.contactName || '微信客服'}} · 查看二维码与微信号</view></view><image class="ui-icon ui-icon--small" src="/images/theme/chevron.svg" /></view>
  </view>
  <view class="theme-signature">在琑遇，好好吃饭</view>
</view>

<view wx:if="{{showContact}}" class="contact-overlay" bindtap="closeContact">
  <view class="contact-sheet" catchtap="keepContactOpen">
    <view class="contact-sheet-handle"></view>
    <view class="contact-sheet-head">
      <view><view class="contact-sheet-title">联系商家</view><view class="contact-sheet-sub">{{contact.contactName || (contact.contactType === 'enterprise_wechat' ? '企业微信客服' : '微信客服')}}</view></view>
      <view class="contact-close" bindtap="closeContact" role="button" aria-label="关闭"><image src="/images/icons/close.png" /></view>
    </view>
    <view class="contact-qr-wrap" bindtap="previewContactQRCode" role="button" aria-label="查看微信二维码大图">
      <image class="contact-qr" src="{{contact.qrCodeUrl}}" mode="aspectFit" show-menu-by-longpress />
    </view>
    <view class="contact-tip">长按识别二维码，或点击查看大图</view>
    <view wx:if="{{contact.wechatId}}" class="contact-wechat-row">
      <view class="contact-wechat-copy"><text>微信号</text><view>{{contact.wechatId}}</view></view>
      <button class="contact-copy-button" bindtap="copyWechatID"><image src="/images/icons/copy.png" />复制</button>
    </view>
  </view>
</view>
