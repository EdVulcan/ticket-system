@import "../../../styles/common.wxss";
.profile-page { padding: 28rpx 30rpx 48rpx; }
.profile-account, .profile-services { background: var(--surface); border: 1rpx solid #efefe8; border-radius: 24rpx; }
.profile-account { padding: 32rpx; }
.profile-header { display: flex; align-items: center; gap: 24rpx; }
.avatar { width: 100rpx; height: 100rpx; background: var(--green-soft); border-radius: 50%; display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0; }
.profile-rabbits { width: 86rpx; height: 78rpx; }
.profile-copy { flex: 1; min-width: 0; }
.profile-name { font-size: 36rpx; font-weight: 700; line-height: 1.4; overflow-wrap: anywhere; }
.profile-sub { font-size: 23rpx; color: var(--muted); margin-top: 8rpx; overflow-wrap: anywhere; }
.member-section { border-top: 1rpx solid var(--line); margin-top: 28rpx; padding-top: 24rpx; }
.member-summary { align-items: center; display: flex; gap: 16rpx; }
.member-copy { flex: 1; min-width: 0; }
.member-title { color: var(--ink); font-size: 27rpx; font-weight: 600; }
.member-sub { color: var(--muted); font-size: 22rpx; line-height: 1.5; margin-top: 5rpx; overflow-wrap: anywhere; }
.member-status { color: var(--green); flex-shrink: 0; font-size: 23rpx; }
.member-action { align-items: center; background: var(--green); border: 0; border-radius: 12rpx; box-sizing: border-box; color: #fff; display: flex; flex: 0 0 164rpx; font-size: 24rpx; justify-content: center; line-height: 1.4; margin: 0; min-height: 72rpx; padding: 16rpx 12rpx; }
.member-action[disabled] { background: #aebcaf; color: #f7faf5; }
.member-action::after { border: 0; }
.member-consent { align-items: center; color: var(--muted); display: flex; font-size: 21rpx; line-height: 1.5; margin-top: 18rpx; min-height: 52rpx; }
.member-consent checkbox { flex-shrink: 0; transform: scale(.72); transform-origin: left center; width: 44rpx; }
.member-consent text { min-width: 0; }
.member-error { color: #b34836; font-size: 21rpx; line-height: 1.45; margin-top: 14rpx; }
.profile-services { margin-top: 24rpx; padding: 0 30rpx; }
.coupon-panel { background: #fafbf7; border-bottom: 1rpx solid var(--line); padding: 0 20rpx; }
.profile-coupon { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx dashed var(--line); gap: 20rpx; }
.profile-coupon:last-child { border: 0; }
.profile-coupon-amount { color: var(--red); font-size: 46rpx; font-weight: 700; min-width: 92rpx; }
.profile-coupon-copy { flex: 1; font-size: 26rpx; min-width: 0; overflow-wrap: anywhere; }
.profile-coupon-copy view:not(:first-child) { color: var(--muted); font-size: 21rpx; margin-top: 5rpx; }
.coupon-empty { padding: 24rpx 0; text-align: center; }
.quick-orders { padding: 24rpx 0 28rpx; border-bottom: 1rpx solid var(--line); }
.quick-orders-head { display: flex; justify-content: space-between; align-items: center; }
.detail-card-title { font-size: 29rpx; font-weight: 600; }
.quick-orders-head .section-link { color: var(--muted); font-size: 22rpx; }
.quick-order-grid { display: flex; margin-top: 24rpx; }
.quick-order-item { box-sizing: border-box; flex: 1; min-width: 0; text-align: center; font-size: 23rpx; color: var(--muted); position: relative; padding: 8rpx 4rpx; }
.quick-order-icon { display: block; width: 44rpx; height: 44rpx; margin: 0 auto 14rpx; }
.quick-order-item text { position: absolute; top: 0; right: 30rpx; background: var(--red); color: #fff; border-radius: 20rpx; font-size: 18rpx; min-width: 28rpx; padding: 0 6rpx; }
.menu-row { box-sizing: border-box; display: flex; align-items: center; gap: 18rpx; min-height: 110rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--line); }
.menu-row:last-child { border-bottom: 0; }
.menu-icon { width: 36rpx; height: 36rpx; flex-shrink: 0; }
.menu-title { flex: 1; min-width: 0; font-size: 27rpx; }
.menu-note { color: var(--muted); flex-shrink: 0; font-size: 22rpx; }
.coupon-count { color: var(--green); flex-shrink: 0; font-size: 32rpx; font-weight: 600; }
.coupon-count text { color: var(--muted); font-size: 22rpx; font-weight: 400; margin-left: 8rpx; }
.coupon-chevron--open { transform: rotate(90deg); }
.contact-overlay { align-items: flex-end; animation: contact-overlay-in 220ms ease-out both; background: rgba(25, 31, 28, .46); bottom: 0; display: flex; left: 0; position: fixed; right: 0; top: 0; z-index: 80; }
.contact-sheet { animation: contact-sheet-in 260ms cubic-bezier(.22, .8, .28, 1) both; background: #fafbf7; border-radius: 32rpx 32rpx 0 0; box-sizing: border-box; padding: 12rpx 36rpx calc(30rpx + env(safe-area-inset-bottom)); width: 100%; }

@keyframes contact-overlay-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes contact-sheet-in { from { opacity: .92; transform: translateY(100%); } to { opacity: 1; transform: translateY(0); } }
.contact-sheet-handle { background: #d7d9d1; border-radius: 999rpx; height: 8rpx; margin: 0 auto 24rpx; width: 68rpx; }
.contact-sheet-head { align-items: flex-start; display: flex; justify-content: center; min-height: 188rpx; position: relative; }
.contact-heading { min-width: 0; text-align: center; }
.contact-sheet-eyebrow { align-items: center; color: #27654b; display: flex; font-size: 20rpx; font-weight: 600; justify-content: center; letter-spacing: 3rpx; }
.contact-eyebrow-dot { background: #27654b; border-radius: 50%; height: 12rpx; margin-right: 10rpx; width: 12rpx; }
.contact-sheet-title { color: var(--ink); font-size: 40rpx; font-weight: 700; line-height: 1.2; margin-top: 10rpx; }
.contact-sheet-sub { color: #7d8a82; font-size: 22rpx; margin-top: 8rpx; }
.contact-rabbits { display: block; height: 76rpx; margin: 12rpx auto 0; width: 104rpx; }
.contact-close { align-items: center; background: #eff0eb; border: 0; border-radius: 50%; display: flex; flex: 0 0 64rpx; height: 64rpx; justify-content: center; position: absolute; right: 0; top: 0; width: 64rpx; }
.contact-close image { height: 26rpx; opacity: .55; width: 26rpx; }
.contact-qr-card { background: #fff; border: 1rpx solid #e8eadf; border-radius: 20rpx; box-shadow: 0 8rpx 24rpx rgba(35, 62, 53, .06); box-sizing: border-box; margin-top: 10rpx; padding: 24rpx 22rpx 18rpx; }
.contact-qr-card-head { align-items: center; display: flex; justify-content: space-between; padding: 0 6rpx 16rpx; }
.contact-qr-label { color: #1e2b25; font-size: 25rpx; font-weight: 700; }
.contact-qr-hint { background: #eaf0ec; border: 1rpx solid rgba(39, 101, 75, .1); border-radius: 999rpx; color: #27654b; font-size: 19rpx; padding: 7rpx 13rpx; }
.contact-qr-wrap { background: #fafcf9; border: 1rpx solid #e8eadd; border-radius: 16rpx; box-sizing: border-box; height: 392rpx; margin: 0 auto; padding: 18rpx; width: 392rpx; }
.contact-qr { display: block; height: 100%; width: 100%; }
.contact-tip { color: var(--muted); font-size: 21rpx; margin-top: 14rpx; text-align: center; }
.contact-wechat-row { align-items: center; background: var(--green-soft); border: 1rpx solid rgba(39, 101, 75, .1); border-radius: 10rpx; color: var(--green); display: flex; gap: 12rpx; justify-content: space-between; margin-top: 16rpx; min-width: 0; padding: 12rpx 16rpx; text-align: left; }
.contact-wechat-value { flex: 1; font-size: 21rpx; min-width: 0; overflow-wrap: anywhere; }
.contact-wechat-copy-hint { color: var(--green); flex: 0 0 auto; font-size: 19rpx; font-weight: 600; }
@media (max-width: 340px) {
  .contact-qr-wrap { height: 330rpx; width: 330rpx; }
}
