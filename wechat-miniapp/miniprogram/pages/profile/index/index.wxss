@import "../../../styles/common.wxss";
.profile-page { padding: 28rpx 30rpx 48rpx; }
.profile-account, .profile-services { background: var(--surface); border: 1rpx solid #efefe8; border-radius: 24rpx; }
.profile-account { padding: 32rpx; }
.profile-header { display: flex; align-items: center; gap: 24rpx; }
.avatar { width: 100rpx; height: 100rpx; background: var(--green-soft); border-radius: 50%; display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0; }
.profile-rabbits { width: 86rpx; height: 78rpx; }
.profile-copy { flex: 1; min-width: 0; }
.profile-name { font-size: 36rpx; font-weight: 700; line-height: 1.4; overflow-wrap: anywhere; }
.profile-sub { font-size: 23rpx; color: var(--muted); margin-top: 8rpx; overflow-wrap: anywhere; }
.member-section { border-top: 1rpx solid var(--line); margin-top: 28rpx; padding-top: 24rpx; }
.member-summary { align-items: center; display: flex; gap: 16rpx; }
.member-copy { flex: 1; min-width: 0; }
.member-title { color: var(--ink); font-size: 27rpx; font-weight: 600; }
.member-sub { color: var(--muted); font-size: 22rpx; line-height: 1.5; margin-top: 5rpx; overflow-wrap: anywhere; }
.member-status { color: var(--green); flex-shrink: 0; font-size: 23rpx; }
.member-action { align-items: center; background: var(--green); border: 0; border-radius: 12rpx; box-sizing: border-box; color: #fff; display: flex; flex: 0 0 164rpx; font-size: 24rpx; justify-content: center; line-height: 1.4; margin: 0; min-height: 72rpx; padding: 16rpx 12rpx; }
.member-action[disabled] { background: #aebcaf; color: #f7faf5; }
.member-action::after { border: 0; }
.member-consent { align-items: center; color: var(--muted); display: flex; font-size: 21rpx; line-height: 1.5; margin-top: 18rpx; min-height: 52rpx; }
.member-consent checkbox { flex-shrink: 0; transform: scale(.72); transform-origin: left center; width: 44rpx; }
.member-consent text { min-width: 0; }
.member-error { color: #b34836; font-size: 21rpx; line-height: 1.45; margin-top: 14rpx; }
.profile-services { margin-top: 24rpx; padding: 0 30rpx; }
.coupon-panel { background: #fafbf7; border-bottom: 1rpx solid var(--line); padding: 0 20rpx; }
.profile-coupon { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx dashed var(--line); gap: 20rpx; }
.profile-coupon:last-child { border: 0; }
.profile-coupon-amount { color: var(--red); font-size: 46rpx; font-weight: 700; min-width: 92rpx; }
.profile-coupon-copy { flex: 1; font-size: 26rpx; min-width: 0; overflow-wrap: anywhere; }
.profile-coupon-copy view:not(:first-child) { color: var(--muted); font-size: 21rpx; margin-top: 5rpx; }
.coupon-empty { padding: 24rpx 0; text-align: center; }
.quick-orders { padding: 24rpx 0 28rpx; border-bottom: 1rpx solid var(--line); }
.quick-orders-head { display: flex; justify-content: space-between; align-items: center; }
.detail-card-title { font-size: 29rpx; font-weight: 600; }
.quick-orders-head .section-link { color: var(--muted); font-size: 22rpx; }
.quick-order-grid { display: flex; margin-top: 24rpx; }
.quick-order-item { box-sizing: border-box; flex: 1; min-width: 0; text-align: center; font-size: 23rpx; color: var(--muted); position: relative; padding: 8rpx 4rpx; }
.quick-order-icon { display: block; width: 44rpx; height: 44rpx; margin: 0 auto 14rpx; }
.quick-order-item text { position: absolute; top: 0; right: 30rpx; background: var(--red); color: #fff; border-radius: 20rpx; font-size: 18rpx; min-width: 28rpx; padding: 0 6rpx; }
.menu-row { box-sizing: border-box; display: flex; align-items: center; gap: 18rpx; min-height: 110rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--line); }
.menu-row:last-child { border-bottom: 0; }
.menu-icon { width: 36rpx; height: 36rpx; flex-shrink: 0; }
.menu-title { flex: 1; min-width: 0; font-size: 27rpx; }
.menu-note { color: var(--muted); flex-shrink: 0; font-size: 22rpx; }
.coupon-count { color: var(--green); flex-shrink: 0; font-size: 32rpx; font-weight: 600; }
.coupon-count text { color: var(--muted); font-size: 22rpx; font-weight: 400; margin-left: 8rpx; }
.coupon-chevron--open { transform: rotate(90deg); }
.contact-overlay { align-items: flex-end; animation: contact-overlay-in 220ms ease-out both; background: rgba(25, 31, 28, .46); bottom: 0; display: flex; left: 0; position: fixed; right: 0; top: 0; z-index: 80; }
.contact-sheet { animation: contact-sheet-in 260ms cubic-bezier(.22, .8, .28, 1) both; background: #fafbf7; border-radius: 32rpx 32rpx 0 0; box-sizing: border-box; padding: 12rpx 36rpx calc(30rpx + env(safe-area-inset-bottom)); width: 100%; }

@keyframes contact-overlay-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes contact-sheet-in { from { opacity: .92; transform: translateY(100%); } to { opacity: 1; transform: translateY(0); } }
.contact-sheet-handle { background: #d7d9d1; border-radius: 999rpx; height: 8rpx; margin: 0 auto 24rpx; width: 68rpx; }
.contact-sheet-head { align-items: flex-start; display: flex; justify-content: center; min-height: 188rpx; position: relative; }
.contact-heading { min-width: 0; text-align: center; }
.contact-sheet-eyebrow { align-items: center; color: #27654b; display: flex; font-size: 20rpx; font-weight: 600; justify-content: center; letter-spacing: 3rpx; }
.contact-eyebrow-dot { background: #27654b; border-radius: 50%; height: 12rpx; margin-right: 10rpx; width: 12rpx; }
.contact-sheet-title { color: var(--ink); font-size: 40rpx; font-weight: 700; line-height: 1.2; margin-top: 10rpx; }
.contact-sheet-sub { color: #7d8a82; font-size: 22rpx; margin-top: 8rpx; }
.contact-rabbits { display: block; height: 76rpx; margin: 12rpx auto 0; width: 104rpx; }
.contact-close { align-items: center; background: #eff0eb; border: 0; border-radius: 50%; display: flex; flex: 0 0 64rpx; height: 64rpx; justify-content: center; position: absolute; right: 0; top: 0; width: 64rpx; }
.contact-close image { height: 26rpx; opacity: .55; width: 26rpx; }
.contact-qr-card { background: #fff; border: 1rpx solid #e8eadf; border-radius: 20rpx; box-shadow: 0 8rpx 24rpx rgba(35, 62, 53, .06); box-sizing: border-box; margin-top: 10rpx; padding: 24rpx 22rpx 18rpx; }
.contact-qr-card-head { align-items: center; display: flex; justify-content: space-between; padding: 0 6rpx 16rpx; }
.contact-qr-label { color: #1e2b25; font-size: 25rpx; font-weight: 700; }
.contact-qr-hint { background: #eaf0ec; border: 1rpx solid rgba(39, 101, 75, .1); border-radius: 999rpx; color: #27654b; font-size: 19rpx; padding: 7rpx 13rpx; }
.contact-qr-wrap { background: #fafcf9; border: 1rpx solid #e8eadd; border-radius: 16rpx; box-sizing: border-box; height: 392rpx; margin: 0 auto; padding: 18rpx; width: 392rpx; }
.contact-qr { display: block; height: 100%; width: 100%; }
.contact-tip { color: var(--muted); font-size: 21rpx; margin-top: 14rpx; text-align: center; }
.contact-wechat-row { align-items: center; background: var(--green-soft); border: 1rpx solid rgba(39, 101, 75, .1); border-radius: 10rpx; color: var(--green); display: flex; gap: 12rpx; justify-content: space-between; margin-top: 16rpx; min-width: 0; padding: 12rpx 16rpx; text-align: left; }
.contact-wechat-value { flex: 1; font-size: 21rpx; min-width: 0; overflow-wrap: anywhere; }
.contact-wechat-copy-hint { color: var(--green); flex: 0 0 auto; font-size: 19rpx; font-weight: 600; }
@media (max-width: 340px) {
  .contact-qr-wrap { height: 330rpx; width: 330rpx; }
}

/* Optimized storefront profile visual system. The data/events above stay unchanged. */
.profile-shell { padding: 24rpx 28rpx 80rpx; }
.profile-user-card, .profile-order-card, .profile-menu-card { background: #fff; border: 1rpx solid #e3e7de; border-radius: 28rpx; box-shadow: 0 8rpx 28rpx rgba(39, 101, 75, .04); }
.profile-user-card { padding: 30rpx; }
.profile-user-header { align-items: center; display: flex; justify-content: space-between; gap: 16rpx; }
.profile-user-left { align-items: center; display: flex; flex: 1; gap: 20rpx; min-width: 0; }
.profile-avatar-wrap { align-items: center; background: var(--green-soft); border: 2rpx solid #d4dfd4; border-radius: 50%; display: flex; flex: 0 0 104rpx; height: 104rpx; justify-content: center; overflow: hidden; width: 104rpx; }
.profile-avatar-wrap .food-photo { border-radius: inherit; height: 100%; width: 100%; }
.profile-rabbits { height: 64rpx; width: 76rpx; }
.profile-greeting-copy { flex: 1; min-width: 0; }
.profile-greeting { color: var(--ink); font-size: 34rpx; font-weight: 800; line-height: 1.35; overflow-wrap: anywhere; }
.profile-sub-desc { color: var(--muted); font-size: 22rpx; margin-top: 5rpx; overflow-wrap: anywhere; }
.store-tag-stamp { align-items: center; background: var(--green-soft); border: 1rpx solid rgba(39, 101, 75, .12); border-radius: 12rpx; display: flex; flex-shrink: 0; gap: 6rpx; max-width: 210rpx; padding: 8rpx 12rpx; }
.store-tag-logo { align-items: center; background: #fff; border-radius: 5rpx; color: var(--green); display: flex; flex: 0 0 32rpx; font-size: 19rpx; font-weight: 800; height: 32rpx; justify-content: center; width: 32rpx; }
.store-tag-text { color: var(--green); flex: 1; font-size: 20rpx; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.profile-assets-bar { border-top: 1rpx dashed var(--line); display: flex; margin-top: 28rpx; padding-top: 24rpx; text-align: center; }
.asset-item { flex: 1; min-width: 0; position: relative; }
.asset-item + .asset-item::before { background: var(--line); content: ''; height: 70%; left: 0; position: absolute; top: 15%; width: 1rpx; }
.asset-val { color: var(--green); font-size: 36rpx; font-weight: 800; line-height: 1.1; }
.asset-val text { font-size: 22rpx; font-weight: 400; }
.asset-val--highlight { color: var(--red); }
.asset-label { color: var(--muted); font-size: 21rpx; margin-top: 6rpx; }
.profile-order-card { margin-top: 20rpx; padding: 28rpx 24rpx 20rpx; }
.profile-card-title-row { align-items: center; border-bottom: 1rpx solid #f3f5ee; display: flex; justify-content: space-between; padding: 0 8rpx 20rpx; }
.card-main-title { color: var(--ink); font-size: 27rpx; font-weight: 800; }
.card-more-link { align-items: center; color: var(--muted); display: flex; font-size: 22rpx; gap: 4rpx; }
.order-status-grid { display: flex; padding: 24rpx 0 8rpx; }
.status-grid-item { align-items: center; display: flex; flex: 1; flex-direction: column; gap: 10rpx; min-width: 0; position: relative; }
.status-icon-wrap { align-items: center; display: flex; height: 56rpx; justify-content: center; position: relative; width: 56rpx; }
.status-icon { height: 46rpx; width: 46rpx; }
.status-badge-dot { align-items: center; background: var(--red); border-radius: 999rpx; color: #fff; display: flex; font-size: 17rpx; height: 28rpx; justify-content: center; min-width: 28rpx; padding: 0 6rpx; position: absolute; right: -8rpx; top: -2rpx; }
.status-grid-label { color: var(--ink); font-size: 22rpx; }
.profile-menu-card { margin-top: 20rpx; padding: 0 28rpx; }
.profile-menu-row { align-items: center; border-bottom: 1rpx solid #f3f5ee; display: flex; justify-content: space-between; min-height: 100rpx; padding: 22rpx 0; }
.profile-menu-row:last-child { border-bottom: 0; }
.menu-left-group { align-items: center; display: flex; flex: 1; gap: 18rpx; min-width: 0; }
.menu-icon-box { align-items: center; border-radius: 12rpx; color: var(--green); display: flex; flex: 0 0 48rpx; height: 48rpx; justify-content: center; width: 48rpx; }
.menu-icon-box--red { color: var(--red); }
.menu-icon-box image { height: 38rpx; width: 38rpx; }
.menu-title-text { color: var(--ink); display: inline-block; font-size: 26rpx; font-weight: 700; }
.menu-sub-tip { color: var(--muted); display: block; font-size: 21rpx; margin-top: 4rpx; overflow-wrap: anywhere; }
.menu-right-group { align-items: center; color: var(--muted); display: flex; flex-shrink: 0; gap: 8rpx; }
.menu-chevron { height: 26rpx; opacity: .65; width: 26rpx; }
.menu-right-tag { background: var(--red-soft); border-radius: 999rpx; color: var(--red); font-size: 19rpx; font-weight: 700; padding: 4rpx 10rpx; }
.menu-contact-tip { color: var(--muted); font-size: 19rpx; }
.profile-coupon-panel { background: #fafbf7; border-bottom: 1rpx solid var(--line); padding: 0 12rpx; }
.profile-coupon { align-items: center; border-bottom: 1rpx dashed var(--line); display: flex; gap: 18rpx; padding: 20rpx 0; }
.profile-coupon:last-child { border-bottom: 0; }
.profile-coupon-amount { color: var(--red); font-size: 34rpx; font-weight: 700; min-width: 86rpx; }
.profile-coupon-copy { flex: 1; font-size: 24rpx; min-width: 0; overflow-wrap: anywhere; }
.profile-coupon-copy view + view { color: var(--muted); font-size: 20rpx; margin-top: 4rpx; }
.coupon-empty { color: var(--muted); font-size: 22rpx; padding: 22rpx 0; text-align: center; }
.profile-brand-footer { margin-top: 42rpx; padding-bottom: 14rpx; text-align: center; }
.brand-footer-text { align-items: center; color: #a2aba5; display: flex; font-size: 21rpx; gap: 16rpx; justify-content: center; letter-spacing: 2rpx; }
.brand-footer-line { background: #d5dbd3; height: 1rpx; width: 60rpx; }
.contact-overlay { align-items: flex-end; animation: contact-overlay-in 220ms ease-out both; background: rgba(25, 31, 28, .55); bottom: 0; display: flex; left: 0; position: fixed; right: 0; top: 0; z-index: 80; }
.contact-sheet { animation: contact-sheet-in 260ms cubic-bezier(.22, .8, .28, 1) both; background: var(--paper); border-radius: 40rpx 40rpx 0 0; box-shadow: 0 -16rpx 48rpx rgba(0, 0, 0, .12); box-sizing: border-box; padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); width: 100%; }
.contact-sheet-handle { background: #d7d9d1; border-radius: 999rpx; height: 8rpx; margin: 0 auto 22rpx; width: 68rpx; }
.contact-sheet-head { padding-bottom: 24rpx; position: relative; text-align: center; }
.contact-eyebrow { align-items: center; background: var(--green-soft); border-radius: 999rpx; color: var(--green); display: inline-flex; font-size: 20rpx; font-weight: 700; gap: 8rpx; padding: 5rpx 16rpx; }
.contact-eyebrow-dot { background: var(--green); border-radius: 50%; height: 10rpx; width: 10rpx; }
.contact-sheet-title { color: var(--ink); font-size: 36rpx; font-weight: 800; margin-top: 12rpx; }
.contact-sheet-sub { color: var(--muted); font-size: 21rpx; margin-top: 4rpx; }
.contact-close { align-items: center; background: #e8eae3; border-radius: 50%; color: #5a635c; display: flex; font-size: 26rpx; height: 56rpx; justify-content: center; position: absolute; right: 0; top: 0; width: 56rpx; }
.contact-flat-card { background: #fff; border: 1rpx solid #e1e7de; border-radius: 28rpx; box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, .03); padding: 28rpx; }
.contact-qr-wrap { align-items: center; background: #fafbf9; border: 1rpx solid var(--line); border-radius: 20rpx; display: flex; height: 340rpx; justify-content: center; margin: 0 auto; padding: 16rpx; width: 340rpx; }
.contact-qr-image { height: 100%; width: 100%; }
.contact-tip { color: var(--muted); font-size: 21rpx; margin-top: 16rpx; text-align: center; }
.contact-wechat-flat-row { align-items: center; background: var(--green-soft); border: 1rpx solid rgba(39, 101, 75, .12); border-radius: 20rpx; display: flex; justify-content: space-between; margin-top: 20rpx; padding: 18rpx 20rpx; }
.contact-wechat-info text { color: var(--muted); display: block; font-size: 19rpx; }
.contact-wechat-info text + text { color: var(--green); font-family: monospace; font-size: 26rpx; font-weight: 700; margin-top: 3rpx; }
.copy-badge-btn { background: var(--green); border-radius: 999rpx; color: #fff; font-size: 21rpx; font-weight: 700; padding: 10rpx 22rpx; }
