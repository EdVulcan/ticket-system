<view class="page-shell assist-page">
  <view class="assist-hero"><image class="assist-brand" src="/images/theme/rabbit-pair.svg" /><view class="assist-hero-title">好事成双，<view>喜欢也成双。</view></view><view class="assist-hero-subtitle">{{brand.name}} · {{campaign.title || '同好一起领券'}}</view><view class="assist-hero-ticket"><view class="ticket-half"><view class="ticket-for">发起者奖励</view><view class="ticket-value">¥{{starterDiscountText}}</view><view class="ticket-benefit">{{starterRewardText}}</view></view><view class="ticket-half ticket-half--friend"><view class="ticket-for">好友奖励</view><view class="ticket-value">¥{{helperDiscountText}}</view><view class="ticket-benefit">{{helperRewardText}}</view></view></view><view class="ticket-benefit">{{benefitText}}</view></view>

  <view wx:if="{{session && session.status === 'active'}}" class="session-card card"><view class="session-badge">进行中</view><view class="session-title">你的助力任务已发起</view><view class="session-desc">分享给 1 位好友，好友点击助力后按两类规则分别到账</view><view class="session-token">助力口令：{{session.token}}</view><button class="primary-button share-button" open-type="share">邀请好友助力</button><view wx:if="{{isDemo}}" class="session-secondary" bindtap="simulateHelp">模拟好友助力（演示）</view></view>
  <view wx:elif="{{session && (session.status === 'success' || session.status === 'completed')}}" class="success-card card"><view class="success-icon"><image class="ui-icon" src="/images/theme/check.svg" /></view><view class="success-title">助力成功，双方券已到账</view><view class="success-desc">发起者：{{starterRewardText}}；好友：{{helperRewardText}}</view><button class="primary-button" bindtap="goHome">去点餐</button></view>
  <view wx:else class="start-card card"><view class="start-icon"><image class="ui-icon" src="/images/theme/rabbit-pair.svg" /></view><view class="start-title">邀请 1 位好友</view><view class="start-desc">好友无需下单，打开小程序点击助力即可。活动期间每人限发起一次。</view><button class="primary-button" bindtap="createSession" disabled="{{creating || !campaignAvailable}}">{{creating ? '发起中' : '发起助力'}}</button></view>

  <view class="assist-rules card"><view class="detail-card-title">活动规则</view><view class="rule-row"><view class="rule-number">1</view><view>每人每期只能发起一次助力</view></view><view class="rule-row"><view class="rule-number">2</view><view>发起者奖励和好友奖励按活动规则分别到账</view></view><view class="rule-row"><view class="rule-number">3</view><view>优惠券仅抵扣商品金额，不抵扣配送费</view></view></view>
</view>
