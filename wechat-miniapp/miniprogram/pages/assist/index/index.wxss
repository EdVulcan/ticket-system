@import "../../../styles/common.wxss";

.assist-page { padding: 28rpx 30rpx 48rpx; }
.assist-content { background: var(--surface); border: 1rpx solid #efefe8; border-radius: 24rpx; overflow: hidden; padding: 0 28rpx; }
.assist-hero { padding: 28rpx 0; position: relative; }
.assist-brand { position: absolute; right: 0; top: 26rpx; width: 90rpx; height: 78rpx; }
.assist-hero-title { padding-right: 104rpx; font-size: 38rpx; font-weight: 700; color: var(--ink); line-height: 1.4; }
.assist-hero-subtitle { color: var(--muted); font-size: 22rpx; margin-top: 10rpx; padding-right: 104rpx; overflow-wrap: anywhere; }
.assist-hero-ticket { width: 100%; display: flex; border: 1rpx solid var(--line); border-radius: 16rpx; overflow: hidden; background: var(--paper); margin-top: 28rpx; }
.ticket-half { width: 50%; min-width: 0; text-align: center; padding: 24rpx 12rpx; }
.ticket-half--friend { border-left: 1rpx dashed var(--line); }
.ticket-for { color: var(--muted); font-size: 22rpx; margin-bottom: 12rpx; }
.ticket-value { color: var(--green); font-size: 58rpx; font-weight: 700; line-height: 1.2; overflow-wrap: anywhere; }
.ticket-half--friend .ticket-value { color: var(--red); }
.ticket-benefit { color: var(--muted); font-size: 22rpx; line-height: 1.6; text-align: center; margin-top: 16rpx; overflow-wrap: anywhere; }
.session-card, .start-card, .success-card { background: transparent; border: 0; border-top: 1rpx solid var(--line); border-radius: 0; padding: 28rpx 0; text-align: center; }
.session-badge { background: var(--green-soft); border-radius: 8rpx; color: var(--green); display: inline-block; font-size: 21rpx; padding: 6rpx 14rpx; }
.session-title, .start-title, .success-title { color: var(--ink); font-size: 29rpx; font-weight: 600; margin-top: 12rpx; }
.session-desc, .start-desc, .success-desc { color: var(--muted); font-size: 23rpx; line-height: 1.7; margin: 12rpx auto 0; max-width: 560rpx; overflow-wrap: anywhere; }
.share-button { margin-top: 24rpx; width: 100%; }
.session-secondary { color: var(--green); font-size: 23rpx; padding: 16rpx 0 0; }
.start-icon, .success-icon { align-items: center; display: flex; height: 64rpx; justify-content: center; margin: 0 auto; width: 84rpx; }
.start-icon .ui-icon { width: 84rpx; height: 64rpx; }
.success-icon .ui-icon { width: 52rpx; height: 52rpx; }
.start-card .primary-button, .success-card .primary-button { margin-top: 24rpx; width: 100%; }
.assist-rules { background: transparent; border: 0; border-top: 1rpx solid var(--line); border-radius: 0; padding: 26rpx 0 28rpx; }
.detail-card-title { font-size: 27rpx; font-weight: 600; }
.rule-row { align-items: flex-start; color: var(--muted); display: flex; font-size: 22rpx; line-height: 1.65; margin-top: 16rpx; }
.rule-number { color: var(--green); flex-shrink: 0; font-size: 22rpx; margin-right: 12rpx; width: 24rpx; }
