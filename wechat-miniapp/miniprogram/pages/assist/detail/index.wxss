@import "../../../styles/common.wxss";

.assist-detail-page { padding: 28rpx 30rpx 48rpx; }
.assist-content { background: var(--surface); border: 1rpx solid #efefe8; border-radius: 24rpx; padding: 28rpx; }
.friend-card { background: transparent; border: 0; padding: 0 0 24rpx; text-align: center; }
.friend-avatar { width: 128rpx; height: 110rpx; display: block; margin: 0 auto; }
.friend-title { color: var(--ink); font-size: 34rpx; font-weight: 700; margin-top: 18rpx; }
.friend-desc { color: var(--muted); font-size: 23rpx; line-height: 1.6; margin-top: 10rpx; overflow-wrap: anywhere; }
.friend-ticket { background: var(--paper); border: 1rpx solid var(--line); border-radius: 16rpx; padding: 28rpx 20rpx; text-align: center; }
.ticket-label { color: var(--muted); font-size: 23rpx; }
.ticket-money { color: var(--red); font-size: 72rpx; font-weight: 700; margin-top: 8rpx; overflow-wrap: anywhere; }
.ticket-condition { color: var(--muted); font-size: 22rpx; overflow-wrap: anywhere; }
.help-action, .help-result { background: transparent; border: 0; border-radius: 0; padding: 24rpx 0 0; text-align: center; }
.help-action .primary-button { width: 100%; }
.result-icon { align-items: center; display: flex; height: 64rpx; justify-content: center; margin: 0 auto 12rpx; width: 64rpx; }
.help-result > view:nth-child(2) { color: var(--ink); font-size: 28rpx; font-weight: 600; }
.help-result .muted-text { font-size: 23rpx; margin-top: 8rpx; }
.assist-detail-note { border-top: 1rpx solid var(--line); color: var(--muted); font-size: 21rpx; line-height: 1.7; margin-top: 24rpx; padding-top: 20rpx; text-align: center; }
