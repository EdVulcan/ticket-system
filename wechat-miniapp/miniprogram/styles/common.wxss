.page-shell, .page-shell--plain { box-sizing: border-box; min-height: 100vh; overflow-x: hidden; padding: 36rpx 32rpx 56rpx; width: 100%; }
.row-between { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.row-between > view, .row-between > text, .row-between > input, .row-between > picker, .row-between > switch { min-width: 0; }
.card { background: var(--surface); border: 1rpx solid var(--line); border-radius: 18rpx; box-shadow: none; }
.section-title { color: var(--ink); font-size: 42rpx; font-weight: 700; letter-spacing: 0; line-height: 1.3; overflow-wrap: anywhere; }
.section-link { display: flex; align-items: center; gap: 6rpx; color: var(--green); font-size: 24rpx; padding: 12rpx 0; }
.muted-text { color: var(--muted); font-size: 24rpx; line-height: 1.6; }
.primary-button { background: var(--green); border-radius: 14rpx; color: #fff; font-size: 28rpx; font-weight: 600; line-height: 88rpx; min-height: 88rpx; padding: 0 32rpx; text-align: center; }
.primary-button--small { display: inline-block; font-size: 24rpx; min-height: 64rpx; height: 64rpx; line-height: 64rpx; padding: 0 24rpx; }
.primary-button::after, .outline-button::after { border: 0; }
.outline-button { background: transparent; border: 2rpx solid #b8c7ba; border-radius: 14rpx; color: var(--green); font-size: 26rpx; min-height: 76rpx; line-height: 72rpx; text-align: center; padding: 0 24rpx; }
.price { color: var(--red); font-size: 36rpx; font-weight: 700; font-family: "DIN Alternate", -apple-system, sans-serif; }
.price::before { content: '¥'; font-size: 22rpx; margin-right: 3rpx; }
.old-price { color: var(--muted); font-size: 22rpx; margin-left: 10rpx; text-decoration: line-through; }
.tag { background: var(--red-soft); border-radius: 5rpx; color: var(--red); font-size: 20rpx; line-height: 32rpx; padding: 0 9rpx; flex-shrink: 0; }
.food-emoji { align-items: center; border-radius: 14rpx; display: flex; flex-shrink: 0; font-size: 68rpx; height: 176rpx; justify-content: center; width: 176rpx; overflow: hidden; }
.food-photo { width: 100%; height: 100%; border-radius: inherit; display: block; }
.empty-state { align-items: center; color: var(--muted); display: flex; flex-direction: column; justify-content: center; padding: 120rpx 30rpx; text-align: center; }
.empty-state__icon { align-items: center; background: var(--green-soft); border-radius: 24rpx; color: var(--green); display: flex; height: 120rpx; justify-content: center; margin-bottom: 28rpx; width: 120rpx; }
.empty-state__icon .ui-icon { width: 58rpx; height: 58rpx; }
.empty-title { color: var(--ink); font-size: 32rpx; font-weight: 600; }
.empty-desc { color: var(--muted); font-size: 24rpx; margin-top: 12rpx; }
.empty-button { margin-top: 32rpx; width: 280rpx; }
.divider { background: var(--line); height: 1rpx; margin: 28rpx 0; }
.bottom-space { height: calc(180rpx + env(safe-area-inset-bottom)); }
.safe-top { padding-top: env(safe-area-inset-top); }
.form-card { padding: 28rpx; }
.form-group { margin-bottom: 28rpx; }
.form-row { display: flex; justify-content: space-between; gap: 20rpx; }
.form-group--half { width: 47%; min-width: 0; }
.form-label { color: var(--ink); font-size: 26rpx; margin-bottom: 14rpx; }
.form-input { background: var(--paper); border: 1rpx solid var(--line); border-radius: 12rpx; box-sizing: border-box; color: var(--ink); font-size: 28rpx; min-width: 0; width: 100%; height: 88rpx; line-height: 88rpx; padding: 0 22rpx; }
.save-tip { color: var(--muted); font-size: 23rpx; line-height: 1.7; margin: 24rpx 6rpx; }
.status-dot { background: var(--green); border-radius: 50%; display: inline-block; height: 10rpx; margin-right: 10rpx; width: 10rpx; }
.ui-icon { display: inline-block; width: 36rpx; height: 36rpx; flex-shrink: 0; vertical-align: middle; }
.ui-icon--small { width: 26rpx; height: 26rpx; }
.ui-icon--large { width: 52rpx; height: 52rpx; }
.theme-signature { display: flex; align-items: center; justify-content: center; gap: 16rpx; color: var(--muted); font-size: 21rpx; letter-spacing: 3rpx; margin-top: 40rpx; }
.theme-signature::before, .theme-signature::after { content: ''; width: 32rpx; height: 2rpx; background: var(--green); }
.theme-signature::after { background: var(--red); }
button:active, .add-button:active, .quantity-button:active { opacity: .75; }

@media (max-width: 360px) {
  .form-row { flex-wrap: wrap; }
  .form-row > .form-group--half, .form-row > .form-group--third { flex: 1 1 100%; margin-right: 0; width: 100%; }
}

/* Brand primitives: text-native 琑 seal and paired-rabbit signature. */
.brand-seal { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 70rpx; height: 76rpx; border: 2rpx solid var(--green); border-radius: 16rpx 16rpx 6rpx 6rpx; color: var(--green); font-family: "Songti SC", "STSong", "SimSun", serif; font-size: 46rpx; line-height: 1; margin-right: 2rpx; }
.brand-seal--red { color: var(--red); border-color: var(--red); }
.empty-brand { width: 180rpx; height: 150rpx; margin-bottom: 28rpx; }
.form-input:focus, .form-textarea:focus { border-color: var(--green); }
